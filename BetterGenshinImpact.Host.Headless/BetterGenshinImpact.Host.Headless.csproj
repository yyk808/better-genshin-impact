<Project Sdk="Microsoft.NET.Sdk">

	<!--
		最小的无界面宿主（纯 net10.0）：经 BetterGenshinImpact.Host.Common 的 GameHost（与 Avalonia 宿主共用）
		用 Linux 平台服务（X11）启动截图器并运行实时触发器（自动拾取 / 自动剧情），用于在 Linux 上做端到端验证。
		OpenCvSharpExtern / onnxruntime 原生库由 Host.Common 引用（本地构建见 Build/Linux/build-opencvsharp.sh）。
		素材与模型从 Windows 主程序的输出目录读取（见 README.md 的 &#45;&#45;assets 参数）；
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>BetterGenshinImpact.Host.Headless</RootNamespace>
		<AssemblyName>bgi-headless</AssemblyName>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>14.0</LangVersion>
		<Platforms>x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\BetterGenshinImpact.Host.Common\BetterGenshinImpact.Host.Common.csproj" />
	</ItemGroup>

</Project>
