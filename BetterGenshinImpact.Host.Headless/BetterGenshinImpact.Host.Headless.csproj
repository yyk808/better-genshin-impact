<Project Sdk="Microsoft.NET.Sdk">

	<!--
		最小的无界面宿主（纯 net10.0）：完成依赖注入、CoreServices / PlatformHost / GameSystem 的初始化，
		用 Linux 平台服务（X11）启动截图器并运行实时触发器（自动拾取 / 自动剧情）。
		作为后续 Avalonia 宿主启动代码的基础，也用于在 Linux 上做端到端验证。
		素材与模型从 Windows 主程序的输出目录读取（见 README.md 的 &#45;&#45;assets 参数）；
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>BetterGenshinImpact.Host.Headless</RootNamespace>
		<AssemblyName>bgi-headless</AssemblyName>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>14.0</LangVersion>
		<Platforms>x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\BetterGenshinImpact.Core\BetterGenshinImpact.Core.csproj" />
		<ProjectReference Include="..\BetterGenshinImpact.Platform.Linux\BetterGenshinImpact.Platform.Linux.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="9.0.1" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
		<!-- OpenCvSharp 的 Linux native 运行时（libOpenCvSharpExtern.so）。
		     官方 OpenCvSharp4.official.runtime.linux-x64 依赖 Ubuntu 22.04 的 tesseract / ffmpeg / gtk2 等系统库，其它发行版上加载失败；
		     这里用不依赖系统库的 Sdcb 精简构建。4.11 的精简构建缺少 dnn（OCR 预处理用到 CvDnn.BlobFromImage），4.13 的包含 dnn。
		     精简构建不含 features2d / calib3d / ximgproc / photo / video 等模块，大地图特征匹配等功能暂不可用 -->
		<PackageReference Include="Sdcb.OpenCvSharp4.mini.runtime.linux-x64" Version="4.13.0.45" />
		<!-- ONNX Runtime 原生库（linux-x64 为 libonnxruntime.so，CPU 推理），版本与 Core 的 Microsoft.ML.OnnxRuntime.Managed 一致 -->
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.21.0" />
	</ItemGroup>

</Project>
