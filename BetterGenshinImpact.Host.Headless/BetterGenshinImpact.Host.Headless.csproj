<Project Sdk="Microsoft.NET.Sdk">

	<!--
		最小的无界面宿主（纯 net10.0）：完成依赖注入、CoreServices / PlatformHost / GameSystem 的初始化，
		用 Linux 平台服务（X11）启动截图器并运行实时触发器（自动拾取 / 自动剧情）。
		作为后续 Avalonia 宿主启动代码的基础，也用于在 Linux 上做端到端验证。
		素材与模型从 Windows 主程序的输出目录读取（见 README.md 的 &#45;&#45;assets 参数）；
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>BetterGenshinImpact.Host.Headless</RootNamespace>
		<AssemblyName>bgi-headless</AssemblyName>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>14.0</LangVersion>
		<Platforms>x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

	<!--
		OpenCvSharp 的 Linux 原生库（libOpenCvSharpExtern.so）：
		- 首选自行编译的完整构建：运行 Build/Linux/build-opencvsharp.sh 生成（OpenCV 4.11 + contrib，与托管包 OpenCvSharp4 4.11 对齐，
		  第三方库与 libstdc++ 静态链接，只依赖 glibc 2.27+）。默认取仓库根目录下 opencv-build/out/libOpenCvSharpExtern.so，
		  可用构建属性或同名环境变量 OpenCvSharpExternPath 指定其它路径。
		- 找不到时退回 Sdcb.OpenCvSharp4.mini.runtime.linux-x64（含 dnn，但不含 features2d / calib3d / xfeatures2d 等，
		  大地图特征匹配等功能不可用）。
		官方 OpenCvSharp4.official.runtime.linux-x64 依赖 Ubuntu 22.04 的 tesseract / ffmpeg / gtk2 等系统库，不使用。
	-->
	<PropertyGroup>
		<OpenCvSharpExternPath Condition="'$(OpenCvSharpExternPath)' == ''">$(MSBuildThisFileDirectory)..\opencv-build\out\libOpenCvSharpExtern.so</OpenCvSharpExternPath>
		<UseLocalOpenCvSharpExtern Condition="Exists('$(OpenCvSharpExternPath)')">true</UseLocalOpenCvSharpExtern>
	</PropertyGroup>

	<ItemGroup Condition="'$(UseLocalOpenCvSharpExtern)' == 'true'">
		<None Include="$(OpenCvSharpExternPath)" Link="runtimes\linux-x64\native\libOpenCvSharpExtern.so"
			CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
	</ItemGroup>

	<ItemGroup Condition="'$(UseLocalOpenCvSharpExtern)' != 'true'">
		<PackageReference Include="Sdcb.OpenCvSharp4.mini.runtime.linux-x64" Version="4.13.0.45" />
	</ItemGroup>

	<Target Name="ReportOpenCvSharpExtern" BeforeTargets="Build">
		<Message Importance="high" Condition="'$(UseLocalOpenCvSharpExtern)' == 'true'" Text="OpenCvSharpExtern：使用本地构建 $(OpenCvSharpExternPath)" />
		<Message Importance="high" Condition="'$(UseLocalOpenCvSharpExtern)' != 'true'" Text="OpenCvSharpExtern：未找到 $(OpenCvSharpExternPath)，使用 Sdcb 精简构建（无 features2d 等模块），完整构建见 Build/Linux/build-opencvsharp.sh" />
	</Target>

	<ItemGroup>
		<ProjectReference Include="..\BetterGenshinImpact.Core\BetterGenshinImpact.Core.csproj" />
		<ProjectReference Include="..\BetterGenshinImpact.Platform.Linux\BetterGenshinImpact.Platform.Linux.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="9.0.1" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
		<!-- ONNX Runtime 原生库（linux-x64 为 libonnxruntime.so，CPU 推理），版本与 Core 的 Microsoft.ML.OnnxRuntime.Managed 一致 -->
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.21.0" />
	</ItemGroup>

</Project>
