<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:BetterGenshinImpact.Avalonia.Views"
        x:Class="BetterGenshinImpact.Avalonia.Views.MaskWindow"
        Title="BetterGI 遮罩" SystemDecorations="None" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        CanResize="False" Background="Transparent" TransparencyLevelHint="Transparent"
        WindowStartupLocation="Manual">
    <Panel>
        <!-- 识别框、线、文字（MaskWindowDrawingBoard 的快照） -->
        <v:MaskDrawingLayer x:Name="Drawing" />
        <!-- 状态栏与日志框：位置、大小、配色、字体、阴影都取自 MaskWindowConfig，与 WPF 遮罩相同（见 ApplyOverlay） -->
        <Canvas x:Name="Root">
            <Border x:Name="StatusBox" CornerRadius="4" ClipToBounds="True" Padding="4,2" MinWidth="160" MinHeight="24">
                <StackPanel x:Name="StatusPanel" Orientation="Horizontal" VerticalAlignment="Top" />
            </Border>
            <Border x:Name="LogBox" CornerRadius="4" MinWidth="240" MinHeight="80" ClipToBounds="True">
                <v:MaskLogView x:Name="LogView" />
            </Border>
            <!-- 布局编辑：虚线框（同 WPF AdjustableOverlayItem 的 PART_EditOutline），只在编辑模式显示 -->
            <Rectangle x:Name="StatusOutline" IsVisible="False" IsHitTestVisible="False" RadiusX="4" RadiusY="4"
                       Stroke="#C5FFFFFF" StrokeDashArray="3,2" StrokeThickness="1" />
            <Rectangle x:Name="LogOutline" IsVisible="False" IsHitTestVisible="False" RadiusX="4" RadiusY="4"
                       Stroke="#C5FFFFFF" StrokeDashArray="3,2" StrokeThickness="1" />
        </Canvas>
        <!-- 布局编辑提示（同 WPF MaskWindow.xaml） -->
        <StackPanel x:Name="EditBanner" IsVisible="False" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Effect>
                <DropShadowEffect Opacity="0.8" BlurRadius="10" OffsetX="0" OffsetY="0" />
            </StackPanel.Effect>
            <TextBlock Text="当前处于编辑模式" FontSize="72" FontWeight="DemiBold" Foreground="#CCFFFFFF" HorizontalAlignment="Center" />
            <TextBlock Text="可以调整日志框、状态栏控件的位置和大小" Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold" Foreground="#CCFFFFFF" HorizontalAlignment="Center" />
            <TextBlock Text="右键相关控件可退出编辑状态" Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold" Foreground="#CCFFFFFF" HorizontalAlignment="Center" />
        </StackPanel>
    </Panel>
</Window>
