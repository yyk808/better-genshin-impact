<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:BetterGenshinImpact.Avalonia.Views"
        x:Class="BetterGenshinImpact.Avalonia.Views.MaskWindow"
        Title="BetterGI 遮罩" SystemDecorations="None" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        CanResize="False" Background="Transparent" TransparencyLevelHint="Transparent"
        WindowStartupLocation="Manual">
    <Panel>
        <!-- 识别框、线、文字（MaskWindowDrawingBoard 的快照） -->
        <v:MaskDrawingLayer x:Name="Drawing" />
        <!-- 左侧日志框（对应原版遮罩的日志框，MaskWindowConfig.ShowLogBox）与左下角状态 -->
        <Canvas x:Name="Root">
            <Border x:Name="LogBox" Canvas.Left="20" Background="#66000000" CornerRadius="4" Padding="8,4" Width="460">
                <TextBlock x:Name="LogText" Foreground="#E0FFFFFF" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </Border>
            <Border x:Name="StatusBox" Canvas.Left="20" Background="#99000000" CornerRadius="4" Padding="8,4">
                <TextBlock x:Name="StatusText" Foreground="#E0FFFFFF" FontSize="12" Text="BetterGI" />
            </Border>
        </Canvas>
    </Panel>
</Window>
