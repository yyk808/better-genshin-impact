<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BetterGenshinImpact.Avalonia.ViewModels"
             xmlns:svc="using:BetterGenshinImpact.Avalonia.Services"
             xmlns:hc="using:BetterGenshinImpact.Host.Common"
             xmlns:hcc="using:BetterGenshinImpact.Host.Common.Config"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="BetterGenshinImpact.Avalonia.Views.HomePage"
             x:DataType="vm:HomePageViewModel">
    <ScrollViewer>
        <StackPanel Margin="28,20,28,20" Spacing="4">
            <!-- 横幅（原版为背景图 + BetterGI 标题） -->
            <Border Height="190" CornerRadius="8" ClipToBounds="True" Margin="0,0,0,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0" Color="#24496B" />
                        <GradientStop Offset="0.55" Color="#3B3A6E" />
                        <GradientStop Offset="1" Color="#6B3F63" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel VerticalAlignment="Bottom" Margin="28,0,0,24">
                    <TextBlock Text="BetterGI" FontSize="40" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="更好的原神，免费且开源" FontSize="16" Foreground="#E6FFFFFF" />
                    <TextBlock Text="Linux 原生宿主（Avalonia）预览版" FontSize="12" Foreground="#B3FFFFFF" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- 截图器：标题行启动 / 停止，展开后为启动相关配置（对应原版首页第一张 CardExpander，图标 Play24） -->
            <ui:FASettingsExpander Header="BetterGI 截图器，启动！" Description="{Binding StatusText}" IconSource="{svc:FluentIconSource Play24}" IsExpanded="True">
                <ui:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- 运行状态点 -->
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,4,0"
                                 Fill="{Binding IsRunning, Converter={x:Static svc:Converters.RunningBrush}}" />
                        <Button Classes="accent" Content="启动" MinWidth="88" HorizontalContentAlignment="Center"
                                Command="{Binding StartCommand}" IsVisible="{Binding !IsRunning}" />
                        <Button Content="停止" MinWidth="88" HorizontalContentAlignment="Center"
                                Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}" />
                    </StackPanel>
                </ui:FASettingsExpander.Footer>
                <ui:FASettingsExpanderItem Content="截图模式" Description="{Binding SelectedCaptureMethod.Description, FallbackValue=''}"
                                           IsVisible="{Binding LinuxConfig, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ComboBox Width="240" ItemsSource="{Binding CaptureMethods}"
                                  SelectedItem="{Binding SelectedCaptureMethod}" IsEnabled="{Binding !IsRunning}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="hc:CaptureMethodInfo">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="触发器间隔（毫秒）" Description="默认50ms，普通用户不建议调整这个值"
                                           IsVisible="{Binding LinuxConfig, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <ui:FASettingsExpanderItem.Footer>
                        <NumericUpDown Width="140" Minimum="1" Maximum="1000" Increment="10" FormatString="0"
                                       Value="{Binding Config.TriggerInterval}" IsEnabled="{Binding !IsRunning}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="手动选择窗口（无法找到原神窗口时使用）" Description="{Binding ManualWindowText}"
                                           IsVisible="{Binding LinuxConfig, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <ui:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="选择捕获窗口" Command="{Binding SelectWindowCommand}" IsEnabled="{Binding !IsRunning}" />
                            <Button Content="清除" Command="{Binding ClearManualWindowCommand}" IsEnabled="{Binding !IsRunning}" />
                        </StackPanel>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="遮罩窗口（预览）"
                                           Description="透明、置顶、点击穿透，跟随游戏画面，显示识别框、日志框和状态；需要合成器。启用后截图默认改用 Composite 窗口图像，不会截到遮罩"
                                           IsVisible="{Binding LinuxConfig, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding LinuxConfig.MaskWindowEnabled}" OnContent="" OffContent="" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="遮罩上显示全部识别结果（调试）"
                                           Description="所有有名称的识别对象匹配成功时都画框（如拾取的 F 键），而不只是任务要求绘制的那些"
                                           IsVisible="{Binding LinuxConfig.MaskWindowEnabled, FallbackValue=False}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding LinuxConfig.MaskDrawAllRecognition}" OnContent="" OffContent="" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Description="{Binding ConfigFileText}"
                                           IsVisible="{Binding LinuxConfig, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </ui:FASettingsExpander>

            <!-- 同时启动原神（Linux：Wine / Proton 等命令；原版图标 LinkSquare24） -->
            <ui:FASettingsExpander Header="同时启动原神" IconSource="{svc:FluentIconSource LinkSquare24}"
                                   Description="启动截图器时，如果原神未启动，则按下方命令启动（Wine / Proton / Steam 等）"
                                   IsVisible="{Binding LinuxConfig, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ui:FASettingsExpander.Footer>
                    <ToggleSwitch OnContent="" OffContent="" MinWidth="0" IsChecked="{Binding LinuxConfig.LaunchGameEnabled}" />
                </ui:FASettingsExpander.Footer>
                <ui:FASettingsExpanderItem Content="启动命令" Description="经 /bin/sh -c 执行，{game} 替换为加引号的游戏路径">
                    <ui:FASettingsExpanderItem.Footer>
                        <ComboBox Width="240" ItemsSource="{Binding LaunchPresets}" SelectedItem="{Binding SelectedPreset}"
                                  PlaceholderText="选择预置命令">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="hcc:LaunchPreset">
                                    <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Description}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="10">
                        <TextBox Text="{Binding LinuxConfig.LaunchCommand}" FontFamily="monospace" PlaceholderText="wine {game}" />
                        <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                            <TextBlock Grid.Row="0" Text="游戏路径" VerticalAlignment="Center" />
                            <DockPanel Grid.Row="0" Grid.Column="1">
                                <Button DockPanel.Dock="Right" Content="浏览" Margin="8,0,0,0" Command="{Binding BrowseGamePathCommand}" />
                                <TextBox Text="{Binding LinuxConfig.GamePath}" PlaceholderText="原神安装位置，如 ~/Games/Genshin Impact/YuanShen.exe" />
                            </DockPanel>
                            <TextBlock Grid.Row="1" Text="工作目录" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LinuxConfig.WorkingDirectory}" PlaceholderText="为空时用游戏所在目录" />
                            <TextBlock Grid.Row="2" Text="环境变量" Margin="0,6,0,0" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LinuxConfig.Environment}" AcceptsReturn="True" Height="70" FontFamily="monospace"
                                     PlaceholderText="每行一个 KEY=VALUE，如 WINEPREFIX=~/.wine-genshin" />
                        </Grid>
                    </StackPanel>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="等待游戏窗口出现（秒）">
                    <ui:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <NumericUpDown Width="140" Minimum="5" Maximum="600" Increment="10" FormatString="0"
                                           Value="{Binding LinuxConfig.LaunchTimeoutSeconds}" />
                            <Button Content="立即启动游戏" Command="{Binding LaunchGameNowCommand}" />
                        </StackPanel>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander>

            <!-- 云原神（网页版）：WebKitGTK 窗口作为游戏画面，键鼠经页面 SDK 发往云端（原版图标 Cloud24） -->
            <ui:FASettingsExpander Header="云原神（网页版）" IconSource="{svc:FluentIconSource Cloud24}"
                                   Description="启用后启动截图器时打开云原神窗口，以网页画面作为游戏画面；键鼠经页面接口发往云端，不需要窗口在前台"
                                   IsVisible="{Binding LinuxConfig, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ui:FASettingsExpander.Footer>
                    <ToggleSwitch OnContent="" OffContent="" MinWidth="0" IsChecked="{Binding LinuxConfig.CloudGameEnabled}" />
                </ui:FASettingsExpander.Footer>
                <ui:FASettingsExpanderItem Content="页面地址">
                    <ui:FASettingsExpanderItem.Footer>
                        <TextBox Width="420" Text="{Binding LinuxConfig.CloudGameUrl}" FontFamily="monospace" PlaceholderText="https://ys.mihoyo.com/cloud/?autobegin=1" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Description="首次使用先打开窗口登录（登录状态保存在 WebKit/CloudGame 目录）；进入游戏后再启动截图器。截图方式建议用 Composite 窗口图像">
                    <ui:FASettingsExpanderItem.Footer>
                        <Button Content="打开云原神窗口" Command="{Binding OpenCloudGameWindowCommand}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander>

            <ui:FASettingsExpander Header="游戏窗口" IconSource="{svc:FluentIconSource Window24}"
                                   Description="经平台服务（X11）按进程名查找，截图与输入（XTest）都作用于该窗口">
                <ui:FASettingsExpander.Footer>
                    <TextBlock Text="{Binding WindowText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>

            <ui:FASettingsExpander Header="已处理帧数" IconSource="{svc:FluentIconSource DataBarVertical24}"
                                   Description="触发器调度器每帧截图并运行已启用的实时触发器">
                <ui:FASettingsExpander.Footer>
                    <TextBlock Text="{Binding FramesText}" FontSize="16" FontWeight="SemiBold" />
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
