<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BetterGenshinImpact.Avalonia.ViewModels"
        x:Class="BetterGenshinImpact.Avalonia.Views.ScriptRepoWindow"
        x:DataType="vm:ScriptRepoWindowViewModel"
        Title="脚本仓库" Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgiWindowBrush}">
    <!-- 与 WPF ScriptRepoWindow 相同：Git 一键更新（渠道、地址、凭据、更新 / 重置）、手动导入 zip、进度、打开仓库 / 一键更新订阅 -->
    <StackPanel Margin="20,16" Spacing="12">
        <Border Padding="14" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="10">
                <TextBlock Text="Git一键更新" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                    <TextBlock Grid.Row="0" Text="更新渠道：" VerticalAlignment="Center" />
                    <ComboBox x:Name="ChannelBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding RepoChannels}" SelectedItem="{Binding SelectedRepoChannel}" />
                    <TextBlock Grid.Row="1" Text="仓库地址：" VerticalAlignment="Center" />
                    <TextBlock x:Name="RepoUrlText" Grid.Row="1" Grid.Column="1" Text="{Binding CurrentRepoUrl}" TextWrapping="Wrap"
                               IsVisible="{Binding IsRepoUrlReadOnly}" VerticalAlignment="Center" />
                    <TextBox x:Name="CustomRepoUrlBox" Grid.Row="1" Grid.Column="1" Text="{Binding Config.CustomRepoUrl}"
                             IsVisible="{Binding !IsRepoUrlReadOnly}" PlaceholderText="https://..." />
                    <TextBlock Grid.Row="2" Text="用户名称：" VerticalAlignment="Center" />
                    <TextBox x:Name="GitUsernameBox" Grid.Row="2" Grid.Column="1" Text="{Binding GitUsername}" PlaceholderText="私有仓库才需要填写" />
                    <TextBlock Grid.Row="3" Text="访问令牌：" VerticalAlignment="Center" />
                    <TextBox x:Name="GitTokenBox" Grid.Row="3" Grid.Column="1" Text="{Binding GitToken}" PasswordChar="●" PlaceholderText="保存在系统密钥环" />
                </Grid>
                <TextBlock x:Name="CredentialMessageText" Text="{Binding CredentialMessage}" Foreground="OrangeRed" TextWrapping="Wrap"
                           IsVisible="{Binding CredentialMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="UpdateRepoButton" Classes="accent" Content="更新仓库" Command="{Binding UpdateRepoCommand}" IsEnabled="{Binding !IsUpdating}" />
                    <Button x:Name="ResetRepoButton" Content="重置仓库" Command="{Binding ResetRepoCommand}" IsEnabled="{Binding !IsUpdating}" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Padding="14" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="8">
                <TextBlock Text="手动导入" FontWeight="SemiBold" />
                <TextBlock Classes="desc" TextWrapping="Wrap" Text="从本地zip文件导入脚本仓库，适用于离线环境或网络不稳定的情况。" />
                <TextBlock Classes="desc" TextWrapping="Wrap" Text="请选择包含脚本仓库内容的zip压缩包文件进行导入。" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Classes="desc" Text="可以从这里获取zip：" VerticalAlignment="Center" />
                    <Button x:Name="RepoDocLink" Padding="0" Background="Transparent" BorderThickness="0" Click="OnRepoDocClick">
                        <TextBlock Text="脚本仓库文档" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </Button>
                </StackPanel>
                <Button x:Name="ImportZipButton" HorizontalAlignment="Right" Content="选择zip文件导入" Command="{Binding ImportLocalScriptsRepoZipCommand}" IsEnabled="{Binding !IsUpdating}" />
            </StackPanel>
        </Border>
        <StackPanel x:Name="ProgressPanel" Spacing="6" IsVisible="{Binding IsUpdating}">
            <TextBlock x:Name="ProgressText" Text="{Binding UpdateProgressText}" TextTrimming="CharacterEllipsis" />
            <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" IsIndeterminate="{Binding IsProgressIndeterminate}" Value="{Binding UpdateProgressValue}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="OpenRepoButton" Classes="accent" Content="打开仓库" Command="{Binding OpenLocalScriptRepoCommand}" IsEnabled="{Binding !IsUpdating}" />
            <Button x:Name="UpdateSubscribedButton" Content="一键更新订阅" Command="{Binding UpdateSubscribedScriptsCommand}" IsEnabled="{Binding !IsUpdating}" />
        </StackPanel>
    </StackPanel>
</Window>
