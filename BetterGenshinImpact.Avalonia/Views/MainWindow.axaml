<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BetterGenshinImpact.Avalonia.ViewModels"
        xmlns:views="using:BetterGenshinImpact.Avalonia.Views"
        xmlns:svc="using:BetterGenshinImpact.Avalonia.Services"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        x:Class="BetterGenshinImpact.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="BetterGI · 更好的原神"
        Width="1050" Height="700" MinWidth="800" MinHeight="520"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:HomePageViewModel">
            <views:HomePage />
        </DataTemplate>
        <DataTemplate DataType="vm:TriggerPageViewModel">
            <views:TriggerPage />
        </DataTemplate>
        <DataTemplate DataType="vm:TaskSettingsPageViewModel">
            <views:TaskSettingsPage />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsPageViewModel">
            <views:SettingsPage />
        </DataTemplate>
        <DataTemplate DataType="vm:TaskPlanPageViewModel">
            <views:TaskPlanPage />
        </DataTemplate>
        <DataTemplate DataType="vm:AutoPageViewModel">
            <views:AutoPage />
        </DataTemplate>
        <DataTemplate DataType="vm:OneDragonPageViewModel">
            <views:OneDragonPage />
        </DataTemplate>
        <DataTemplate DataType="vm:EnvironmentPageViewModel">
            <views:EnvironmentPage />
        </DataTemplate>
        <DataTemplate DataType="vm:NewOneDragonPageViewModel">
            <views:NewOneDragonPage />
        </DataTemplate>
        <DataTemplate DataType="vm:TaskHistoryPageViewModel">
            <views:TaskHistoryPage />
        </DataTemplate>
        <DataTemplate DataType="vm:PlaceholderPageViewModel">
            <StackPanel Classes="page">
                <TextBlock Classes="pagetitle" Text="{Binding Title}" />
                <ui:FAInfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="尚未迁移" Message="{Binding Description}" />
            </StackPanel>
        </DataTemplate>
    </Window.DataTemplates>

    <!-- 左侧导航：FluentAvalonia 的 NavigationView（对应 WPF 版 WPF-UI 的 NavigationView，导航项在代码中按 ViewModel 生成） -->
    <ui:FANavigationView x:Name="RootNavigation" PaneDisplayMode="Left" OpenPaneLength="160"
                         IsBackButtonVisible="False" IsSettingsVisible="False" IsPaneToggleButtonVisible="True"
                         AlwaysShowHeader="False">

        <!-- 内容区 + 底部日志面板 -->
        <Grid RowDefinitions="*,Auto,Auto">
            <ContentControl Grid.Row="0" Content="{Binding CurrentPage}" />

            <!-- 轻提示（UiHost.Dialogs.Toast）：InfoBar -->
            <ui:FAInfoBar x:Name="ToastBar" Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Right"
                          Margin="0,14,20,0" MaxWidth="520" IsClosable="True"
                          IsOpen="{Binding HasToast, Mode=OneWay}" Message="{Binding ToastText}"
                          Severity="{Binding ToastKind, Converter={x:Static svc:Converters.InfoBarSeverity}}"
                          CloseButtonCommand="{Binding HideToastCommand}" />

            <GridSplitter Grid.Row="1" Height="4" Background="{DynamicResource CardStrokeColorDefaultBrush}" ResizeDirection="Rows" IsVisible="{Binding IsLogExpanded}" />

            <Border Grid.Row="2" Background="{DynamicResource LayerFillColorAltBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,4">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                            <CheckBox Content="调试日志" IsChecked="{Binding ShowDebugLog}" FontSize="12" />
                            <Button Content="复制" FontSize="12" Padding="10,2" Command="{Binding CopyLogCommand}" />
                            <Button Content="清空" FontSize="12" Padding="10,2" Command="{Binding ClearLogCommand}" />
                            <Button Content="{Binding IsLogExpanded, Converter={x:Static svc:Converters.ExpandGlyph}}" FontSize="12" Padding="10,2"
                                    Command="{Binding ToggleLogCommand}" />
                        </StackPanel>
                        <TextBlock Text="日志" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox x:Name="LogList" Classes="log" Height="190" IsVisible="{Binding IsLogExpanded}"
                             Background="Transparent" ItemsSource="{Binding LogLines}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="svc:LogLine">
                                <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="NoWrap"
                                           Foreground="{Binding Level, Converter={x:Static svc:Converters.LogLevelBrush}}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </ui:FANavigationView>
</Window>
