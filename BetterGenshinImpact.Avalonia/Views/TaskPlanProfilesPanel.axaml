<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BetterGenshinImpact.Avalonia.ViewModels"
             x:Class="BetterGenshinImpact.Avalonia.Views.TaskPlanProfilesPanel"
             x:DataType="vm:TaskPlanPageViewModel">
    <!-- 设置方案与计划级共享设置（任务计划页“设置方案”页签与新一条龙“共享设置”页签共用，DataContext 为 TaskPlanPageViewModel） -->
        <ScrollViewer>
            <StackPanel Spacing="8" Margin="0,4,0,0">
                <TextBlock Text="本计划使用的方案" FontWeight="SemiBold" />
                <ComboBox Name="PlanProfileBox" ItemsSource="{Binding PlanProfileOptions}" SelectedItem="{Binding PlanProfile}" MinWidth="260"
                          DisplayMemberBinding="{Binding Name}" />
                <Button Name="EditPlanSettingsButton" Content="编辑计划级共享设置" Command="{Binding EditPlanSettingsCommand}" />
                <TextBlock Classes="desc" TextWrapping="Wrap"
                           Text="计划级共享设置：方案中的设置（队伍、战斗、拾取、路线 CD 等）传给计划中的全部任务，任务或分组自己的设置优先。方案与 Windows 版共用（User/Pulonia/profiles）。" />
                <Separator Margin="0,4" />
                <TextBlock Text="设置方案管理" FontWeight="SemiBold" />
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Spacing="6" Margin="10,0,0,0">
                        <TextBox Name="ProfileNameBox" Text="{Binding ProfileName}" Watermark="方案名称" Width="200" />
                        <Button Name="CreateProfileButton" Content="新建" Command="{Binding CreateProfileCommand}" HorizontalAlignment="Stretch" />
                        <Button Name="DuplicateProfileButton" Content="复制" Command="{Binding DuplicateProfileCommand}" HorizontalAlignment="Stretch" />
                        <Button Name="RenameProfileButton" Content="重命名" Command="{Binding RenameProfileCommand}" HorizontalAlignment="Stretch" />
                        <Button Name="DeleteProfileButton" Content="删除" Command="{Binding DeleteProfileCommand}" HorizontalAlignment="Stretch" />
                        <Button Name="EditProfileSettingsButton" Content="编辑方案设置" Command="{Binding EditProfileSettingsCommand}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <ListBox Name="ProfileList" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" MinHeight="160">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TaskPlanProfileItem">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.65" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Classes="desc" TextWrapping="Wrap" Text="{Binding ProfileUsageText}" />
                    </StackPanel>
                </DockPanel>
                <!-- 共享设置编辑（计划级或方案） -->
                <Border Name="SharedSettingsPanel" IsVisible="{Binding SharedEditor, Converter={x:Static ObjectConverters.IsNotNull}}"
                        BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,6,0,0">
                    <StackPanel Spacing="8" DataContext="{Binding SharedEditor}" x:DataType="vm:TaskPlanSharedSettingsEditor">
                        <DockPanel>
                            <Button Name="SaveSharedSettingsButton" DockPanel.Dock="Right" Classes="accent" Content="保存" Command="{Binding SaveCommand}" />
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <ComboBox Name="SharedCategoryBox" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" MinWidth="200"
                                  DisplayMemberBinding="{Binding DisplayName}" />
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TaskPlanSharedSettingRow">
                                    <Grid ColumnDefinitions="*,260" Margin="0,4">
                                        <StackPanel>
                                            <CheckBox IsChecked="{Binding IsOverridden}" Content="{Binding Name}" ToolTip.Tip="勾选：在此处覆盖；不勾选：继承上层" />
                                            <TextBlock Classes="desc" Text="{Binding Description}" TextWrapping="Wrap" Margin="28,0,0,0"
                                                       IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <TextBlock Classes="desc" Text="{Binding InheritedText, StringFormat='继承值：{0}'}" Margin="28,0,0,0" />
                                            <TextBlock Classes="desc" Text="{Binding Cooldown.Preview, FallbackValue=''}" Margin="28,4,0,0" TextWrapping="Wrap"
                                                       IsVisible="{Binding IsCooldown}" />
                                        </StackPanel>
                                        <Panel Grid.Column="1" VerticalAlignment="Center">
                                            <ToggleSwitch IsChecked="{Binding BoolValue}" IsVisible="{Binding IsBoolean}" OnContent="" OffContent="" HorizontalAlignment="Right" />
                                            <NumericUpDown Value="{Binding NumberValue}" IsVisible="{Binding IsNumber}" />
                                            <ComboBox ItemsSource="{Binding ChoiceLabels}" SelectedIndex="{Binding ChoiceIndex}" IsVisible="{Binding IsChoice}" HorizontalAlignment="Stretch" />
                                            <TextBox Text="{Binding TextValue}" IsVisible="{Binding IsText}" TextWrapping="Wrap" />
                                            <StackPanel Spacing="6" IsVisible="{Binding IsCooldown}">
                                                <ComboBox Name="CdChoiceBox" ItemsSource="{Binding CdChoiceLabels}" SelectedIndex="{Binding CdChoiceIndex}" HorizontalAlignment="Stretch" />
                                                <ComboBox Name="CdModeBox" ItemsSource="{Binding CdModeLabels}" SelectedIndex="{Binding CdModeIndex}" HorizontalAlignment="Stretch"
                                                          IsVisible="{Binding Cooldown.ShowCustom, FallbackValue=False}" />
                                                <DockPanel IsVisible="{Binding Cooldown.ShowHours, FallbackValue=False}">
                                                    <TextBlock DockPanel.Dock="Right" Text="小时" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                    <TextBox Name="CdHoursBox" Text="{Binding Cooldown.Hours, FallbackValue=''}" />
                                                </DockPanel>
                                                <DockPanel IsVisible="{Binding Cooldown.ShowDays, FallbackValue=False}">
                                                    <TextBlock DockPanel.Dock="Right" Text="天" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                    <TextBox Name="CdDaysBox" Text="{Binding Cooldown.Days, FallbackValue=''}" />
                                                </DockPanel>
                                                <ComboBox ItemsSource="{Binding CdWeekdayLabels}" SelectedIndex="{Binding CdWeekdayIndex}" HorizontalAlignment="Stretch"
                                                          IsVisible="{Binding Cooldown.ShowWeekday, FallbackValue=False}" />
                                                <ComboBox ItemsSource="{Binding CdHourLabels}" SelectedIndex="{Binding CdResetHourIndex}" HorizontalAlignment="Stretch"
                                                          IsVisible="{Binding Cooldown.ShowResetHour, FallbackValue=False}" ToolTip.Tip="服务器时间重置时刻" />
                                            </StackPanel>
                                        </Panel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Name="SharedSettingsMessage" Classes="desc" Text="{Binding Message}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
</UserControl>
