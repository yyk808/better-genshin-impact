<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BetterGenshinImpact.Avalonia.ViewModels"
             xmlns:tasksVm="using:BetterGenshinImpact.ViewModel.SoloTaskSettings"
             x:Class="BetterGenshinImpact.Avalonia.Views.SoloTaskSettings.AutoBossSettingsEditor"
             x:DataType="tasksVm:AutoBossSettingsViewModel">
    <!-- 自动首领讨伐专属参数（对照 WPF AutoBossSettingsView） -->
    <UserControl.Styles>
        <Style Selector="StackPanel.row"><Setter Property="Spacing" Value="3" /><Setter Property="Margin" Value="0,4" /></Style>
        <Style Selector="StackPanel.row > TextBlock.desc"><Setter Property="FontSize" Value="12" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
        <Style Selector="StackPanel.row > ComboBox"><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
        <Style Selector="StackPanel.indent"><Setter Property="Margin" Value="12,0,0,0" /></Style>
    </UserControl.Styles>
    <StackPanel>
        <TextBlock Text="自动首领讨伐设置" FontWeight="SemiBold" Margin="0,4,0,0" />
        <StackPanel Classes="row">
            <TextBlock Text="战斗策略" />
            <TextBlock Classes="desc" Text="选择此任务使用的首领讨伐策略。" />
            <ComboBox x:Name="BossStrategy" ItemsSource="{x:Static vm:DedicatedTaskSettingsChoices.FightStrategies}" SelectedItem="{Binding StrategyName}" />
        </StackPanel>
        <StackPanel Classes="row">
            <TextBlock Text="讨伐首领" />
            <TextBlock Classes="desc" Text="选择要挑战的首领，暂不支持部分特殊机制首领。" />
            <ComboBox x:Name="BossName" ItemsSource="{x:Static vm:DedicatedTaskSettingsChoices.BossNames}" SelectedItem="{Binding BossNameChoice}" />
        </StackPanel>
        <StackPanel Classes="row">
            <TextBlock Text="战斗队伍" />
            <TextBlock Classes="desc" Text="填写游戏内队伍名称；留空使用当前队伍。" />
            <TextBox x:Name="BossTeamName" Text="{Binding TeamName}" Watermark="留空则不切换队伍" />
        </StackPanel>
        <StackPanel Classes="row">
            <TextBlock Text="树脂使用" FontWeight="SemiBold" />
            <TextBlock x:Name="BossResinSummary" Classes="desc" Text="{Binding Resin.Summary}" />
            <TextBlock Classes="desc" Foreground="#E0A000" Text="{Binding Resin.Problem}" IsVisible="{Binding Resin.HasProblem}" />
            <Button x:Name="BossResinButton" Content="设置" Command="{Binding Resin.EditCommand}" HorizontalAlignment="Left" MinWidth="88" />
        </StackPanel>
        <StackPanel Classes="row">
            <TextBlock Text="累计成功领奖次数" FontWeight="SemiBold" />
            <TextBlock Classes="desc" Text="跨次运行累计，每个任务、账号分别统计；0 表示不限制。" />
        </StackPanel>
        <StackPanel Classes="row indent">
            <TextBlock Text="累计上限" />
            <TextBlock Classes="desc" Text="到达上限后跳过本任务，不影响后续步骤。" />
            <NumericUpDown x:Name="BossRunLimit" Minimum="0" Increment="1" FormatString="0" Value="{Binding TotalRunCountLimit}" />
            <TextBlock x:Name="BossCompletedText" Classes="desc" Text="{Binding CompletedRunCountText}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BossRefreshProgress" Content="刷新累计" Command="{Binding RefreshProgressCommand}" />
                <Button x:Name="BossResetProgress" Content="清空累计" Command="{Binding ResetProgressCommand}" />
            </StackPanel>
        </StackPanel>
        <StackPanel Classes="row">
            <TextBlock Text="每轮结束返回七天神像" />
            <TextBlock Classes="desc" Text="领奖后先回神像恢复，再前往首领开始下一轮。" />
            <ToggleSwitch x:Name="BossReturnToStatue" IsChecked="{Binding ReturnToStatueAfterEachRound}" OnContent="" OffContent="" />
        </StackPanel>
        <StackPanel Classes="row">
            <TextBlock Text="奖励识别" />
            <TextBlock Classes="desc" Text="每轮领奖后识别奖励名称与数量，测试功能，如有问题请提交截图反馈。" />
            <ToggleSwitch x:Name="BossRewardRecognition" IsChecked="{Binding RewardRecognitionEnabled}" OnContent="" OffContent="" />
        </StackPanel>
        <StackPanel Classes="row">
            <TextBlock Text="角色死亡后重试次数" />
            <TextBlock Classes="desc" Text="复活后重新挑战当前首领，0 表示不重试。" />
            <NumericUpDown x:Name="BossReviveRetry" Minimum="0" Increment="1" FormatString="0" Value="{Binding ReviveRetryCount}" />
        </StackPanel>
    </StackPanel>
</UserControl>
