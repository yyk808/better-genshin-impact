<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BetterGenshinImpact.Avalonia.ViewModels"
        xmlns:tasksVm="using:BetterGenshinImpact.ViewModel.SoloTaskSettings"
        xmlns:pulonia="using:BetterGenshinImpact.ViewModel.Pages.Pulonia"
        xmlns:services="using:BetterGenshinImpact.Avalonia.Services"
        x:Class="BetterGenshinImpact.Avalonia.Views.ResinPlanSubTaskWindow"
        x:DataType="tasksVm:ResinPlanSubTaskSettingsViewModel"
        Width="600" Height="680" WindowStartupLocation="CenterOwner" Title="{Binding Title}">
    <!-- 体力计划子任务设置（对照 WPF ResinPlanSubTaskSettingsWindow；字段模型为 Core 的一条龙参数字段） -->
    <Window.Styles>
        <Style Selector="TextBlock.desc"><Setter Property="FontSize" Value="12" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Opacity" Value="0.75" /></Style>
    </Window.Styles>
    <Window.DataTemplates>
        <DataTemplate DataType="pulonia:PuloniaOneDragonParameterFieldViewModel">
            <!-- 与 WPF 卡片相同：标题与说明在左，开关 / 下拉 / 输入框在同一行右侧；对象与树脂使用等复合字段在下方展开 -->
            <Border Margin="0,4" Padding="12,8" CornerRadius="6" Background="#14808080">
                <StackPanel Spacing="6" Tag="{Binding Name}">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                            <TextBlock Classes="desc" Text="{Binding Description}" />
                        </StackPanel>
                        <Panel Grid.Column="1" VerticalAlignment="Center">
                            <ToggleSwitch IsChecked="{Binding BooleanValue}" IsVisible="{Binding IsBoolean}" OnContent="" OffContent="" MinWidth="0" />
                            <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" IsVisible="{Binding IsChoice}" Width="200" />
                            <ComboBox ItemsSource="{x:Static vm:DedicatedTaskSettingsChoices.FightStrategies}"
                                      SelectedItem="{Binding TextValue, Converter={x:Static services:Converters.CombatStrategyValue}}"
                                      IsVisible="{Binding IsCombatStrategy}" Width="200" />
                            <StackPanel IsVisible="{Binding IsSourcedDomain}" Orientation="Horizontal" Spacing="12">
                                <RadioButton Content="跟随培养计划" GroupName="{Binding Name}" IsChecked="{Binding IsFollowTrainingPlan}" />
                                <RadioButton Content="指定秘境" GroupName="{Binding Name}" IsChecked="{Binding IsManualDomain}" />
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding DomainItems}" SelectedItem="{Binding SelectedDomainItem}" Width="200" IsVisible="{Binding IsPlainDomain}" />
                            <TextBox Text="{Binding TextValue}" IsVisible="{Binding IsNumber}" Width="140" />
                            <TextBox Text="{Binding TextValue}" IsVisible="{Binding IsText}" Width="200" />
                            <Button Content="设置" Command="{Binding Resin.EditCommand, FallbackValue={x:Null}}" IsVisible="{Binding IsResinUsage}" MinWidth="88" />
                        </Panel>
                    </Grid>
                    <TextBlock Classes="desc" Text="{Binding Resin.Summary, FallbackValue=''}" IsVisible="{Binding IsResinUsage}" />
                    <TextBlock Classes="desc" Text="{Binding DomainSourceDescription}" IsVisible="{Binding IsSourcedDomain}" />
                    <ComboBox ItemsSource="{Binding DomainItems}" SelectedItem="{Binding SelectedDomainItem}" HorizontalAlignment="Stretch" IsVisible="{Binding IsSourcedDomain}" IsEnabled="{Binding IsManualDomain}" />
                    <TextBox Text="{Binding TextValue}" IsVisible="{Binding IsAdvancedJson}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                    <ItemsControl ItemsSource="{Binding Children}" IsVisible="{Binding IsObject}" Margin="8,0,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.DataTemplates>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="20,12" Background="#18808080">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="SubTaskValidationText" Text="{Binding ValidationMessage}" TextWrapping="Wrap" Foreground="#E0A000" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SubTaskConfirmButton" Content="确定" Classes="accent" MinWidth="72" IsDefault="True" Click="Confirm_Click" />
                    <Button x:Name="SubTaskCancelButton" Content="取消" MinWidth="72" IsCancel="True" Click="Cancel_Click" />
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer Padding="20,12">
            <StackPanel>
                <TextBlock Classes="desc" Text="{Binding Description}" Margin="0,0,0,8" />
                <ItemsControl x:Name="SubTaskFields" ItemsSource="{Binding Fields}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
