<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BetterGenshinImpact.Avalonia.ViewModels"
             xmlns:svc="using:BetterGenshinImpact.Avalonia.Services"
             xmlns:views="using:BetterGenshinImpact.Avalonia.Views"
             xmlns:tasksVm="using:BetterGenshinImpact.ViewModel.SoloTaskSettings"
             xmlns:solo="using:BetterGenshinImpact.Avalonia.Views.SoloTaskSettings"
             x:Class="BetterGenshinImpact.Avalonia.Views.TaskPlanPage"
             x:DataType="vm:TaskPlanPageViewModel">
    <DockPanel Margin="20,16,20,12">
        <TextBlock DockPanel.Dock="Bottom" Classes="desc" Margin="4,8,0,0" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="230,*">
            <!-- 左侧：计划列表 -->
            <Border Grid.Column="0" Classes="card" Margin="0,0,10,0" Padding="10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="4,0,0,8">
                        <Button DockPanel.Dock="Right" Content="{svc:FluentIcon ArrowClockwise24, Size=16}" Padding="8,4" Command="{Binding ReloadCommand}" ToolTip.Tip="重新加载" Margin="4,0,0,0" />
                        <!-- 与 WPF 计划列表标题栏相同：三项资源操作收进带文字的菜单 -->
                        <DropDownButton x:Name="ResourceSyncButton" DockPanel.Dock="Right" Content="{svc:FluentIcon ArrowSync24, Size=16}" Padding="8,4"
                                        ToolTip.Tip="任务资源同步与更新">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="一键同步并更新" Command="{Binding SyncAndUpdateResourcesCommand}" ToolTip.Tip="同步全部计划引用的仓库，并更新所有可用任务资源" />
                                    <MenuItem Header="使用本机仓库更新所有计划" Command="{Binding UpdateAllResourcesCommand}" ToolTip.Tip="使用本机仓库内容更新所有任务计划" />
                                    <MenuItem Header="检查任务资源更新" Command="{Binding CheckResourceUpdatesCommand}" ToolTip.Tip="只检查本机仓库与任务使用版本，不访问远端" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="计划" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Classes="desc" Text="{Binding PlanCountText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{svc:FluentIcon Add24, Size=16}" Margin="6,0,0,0" Command="{Binding NewPlanCommand}" ToolTip.Tip="新建计划" />
                            <TextBox Watermark="新计划名称" Text="{Binding NewPlanName}" />
                        </DockPanel>
                        <Button Content="删除计划" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding DeletePlanCommand}" IsEnabled="{Binding HasSelectedPlan}" />
                        <TextBlock Classes="desc" Text="计划保存在 User/Pulonia，与 Windows 版共用" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TaskPlanItem">
                                <DockPanel Margin="2,4">
                                    <Button DockPanel.Dock="Right" Content="{svc:FluentIcon Play24, Size=16}" Padding="8,4" VerticalAlignment="Center" ToolTip.Tip="运行"
                                            Command="{Binding $parent[ListBox].((vm:TaskPlanPageViewModel)DataContext).RunPlanCommand}"
                                            CommandParameter="{Binding}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Classes="desc" Text="{Binding Summary}" />
                                            <TextBlock Classes="desc" Text="· 运行中" Foreground="#4CC2FF" IsVisible="{Binding IsRunning}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 右侧：当前计划 -->
            <Border Grid.Column="1" Classes="card" Padding="14,10">
                <Panel>
                    <TextBlock Classes="desc" Text="还没有任务计划，在左侧输入名称后点“＋”新建。" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding !HasSelectedPlan}" />
                    <DockPanel IsVisible="{Binding HasSelectedPlan}">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Name="PreviewRunButton" Content="预览" MinWidth="64" HorizontalContentAlignment="Center"
                                        Command="{Binding PreviewRunCommand}" ToolTip.Tip="预览本次执行：逐项预测执行或因路线 CD 跳过" />
                                <Button Classes="accent" Content="运行" MinWidth="72" HorizontalContentAlignment="Center"
                                        Command="{Binding RunPlanCommand}" CommandParameter="{x:Null}" IsVisible="{Binding !IsSelectedPlanRunning}" />
                                <Button Classes="danger" Content="停止" MinWidth="72" HorizontalContentAlignment="Center"
                                        Command="{Binding StopPlanCommand}" IsVisible="{Binding IsSelectedPlanRunning}" />
                            </StackPanel>
                            <TextBlock Classes="pageTitle" FontSize="20" Text="{Binding SelectedPlan.Name, FallbackValue=''}" />
                        </DockPanel>
                        <TabControl SelectedIndex="{Binding SelectedTab}">
                            <TabItem Header="任务">
                                <DockPanel Margin="0,6,0,0">
                                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <ComboBox ItemsSource="{Binding AddOptions}" SelectedItem="{Binding SelectedAddOption}" MinWidth="170"
                                                  PlaceholderText="任务类型" Margin="0,0,6,4" />
                                        <ComboBox ItemsSource="{Binding Resources}" SelectedItem="{Binding SelectedResource}" MinWidth="220" MaxWidth="360"
                                                  IsVisible="{Binding HasResources}" Margin="0,0,6,4" />
                                        <Button Content="＋ 添加" Command="{Binding AddTaskCommand}" Margin="0,0,6,4" />
                                        <Button Content="分组" Command="{Binding AddGroupCommand}" Margin="0,0,6,4" />
                                        <ComboBox Name="ReferencePlanBox" ItemsSource="{Binding ReferencePlans}" SelectedItem="{Binding ReferenceTarget}"
                                                  PlaceholderText="引用计划" MinWidth="140" Margin="0,0,6,4" DisplayMemberBinding="{Binding Name}" />
                                        <Button Name="AddPlanReferenceButton" Content="引用" Command="{Binding AddPlanReferenceCommand}" Margin="0,0,14,4"
                                                ToolTip.Tip="引用已有任务计划：不复制内容，之后修改该计划会同步影响这里" />
                                        <Button Content="↑" Command="{Binding MoveTaskCommand}" CommandParameter="up" Margin="0,0,4,4" ToolTip.Tip="上移" />
                                        <Button Content="↓" Command="{Binding MoveTaskCommand}" CommandParameter="down" Margin="0,0,4,4" ToolTip.Tip="下移" />
                                        <Button Content="删除" Command="{Binding RemoveTaskCommand}" Margin="0,0,4,4" />
                                        <Button Name="CopyTaskButton" Content="复制" Command="{Binding CopyTaskCommand}" Margin="10,0,4,4" ToolTip.Tip="复制选中任务（含子项），可粘贴到任意计划" />
                                        <Button Name="PasteTaskButton" Content="粘贴" Command="{Binding PasteTaskCommand}" Margin="0,0,4,4" ToolTip.Tip="粘贴为独立副本：选中分组时粘贴到分组内，否则粘贴到末尾" />
                                        <Button Name="EnableAllButton" Content="启用全部" Command="{Binding EnableAllCommand}" Margin="0,0,4,4" ToolTip.Tip="选中分组时启用其全部子项，否则启用整个计划" />
                                        <Button Name="UndoButton" Content="撤销" Command="{Binding UndoCommand}" Margin="0,0,4,4" ToolTip.Tip="撤销当前计划最近一次修改（最多 30 步）" />
                                        <Button Name="NodeSettingsButton" Content="共享设置" Command="{Binding EditNodeSettingsCommand}" Margin="0,0,4,4"
                                                ToolTip.Tip="编辑选中分组或任务自身的共享设置（优先于计划级设置与方案）" />
                                        <Button Name="UpdateResourceButton" Content="更新资源…" Command="{Binding UpdateSelectedResourceCommand}" Margin="0,0,4,4"
                                                IsEnabled="{Binding CanUpdateSelectedResource}"
                                                ToolTip.Tip="更新此任务资源：重新读取本机仓库，确认后更新任务使用版本（WPF 任务树右键“更新此任务资源…”）" />
                                    </WrapPanel>
                                    <TextBlock Name="PlanCooldownSummaryText" DockPanel.Dock="Top" Classes="desc" Margin="2,0,0,6" Text="{Binding PlanCooldownSummary}"
                                               ToolTip.Tip="{Binding PlanCooldownSummaryTip}"
                                               IsVisible="{Binding PlanCooldownSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <Border DockPanel.Dock="Top" Background="#14FFFFFF" CornerRadius="4" Padding="12,6">
                                        <Grid ColumnDefinitions="*,90,44">
                                            <TextBlock Classes="desc" Text="名称" />
                                            <TextBlock Grid.Column="1" Classes="desc" Text="类型" />
                                            <TextBlock Grid.Column="2" Classes="desc" Text="启用" />
                                        </Grid>
                                    </Border>
                                    <Border DockPanel.Dock="Right" Width="290" Margin="10,0,0,0" Padding="10,8" Background="#0FFFFFFF" CornerRadius="4"
                                            IsVisible="{Binding HasNodeEditor}">
                                        <views:TaskNodeEditorPanel />
                                    </Border>
                                    <Panel>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" IsVisible="{Binding HasNoNodes}">
                                            <TextBlock Text="这个计划还没有任务" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <TextBlock Classes="desc" Text="在上方选择任务类型（独立任务、录制回放、地图追踪、JS 脚本、Shell）后点“添加”" />
                                        </StackPanel>
                                        <ListBox ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}" Background="Transparent">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:TaskPlanNodeRow">
                                                    <Grid ColumnDefinitions="*,90,44" Opacity="{Binding RowOpacity}">
                                                        <StackPanel Margin="{Binding Indent}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding Name}" />
                                                                <Border Classes="cdBadge" Background="#33E0A030" CornerRadius="3" Padding="5,0"
                                                                        ToolTip.Tip="{Binding CooldownTip}"
                                                                        IsVisible="{Binding CooldownBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                    <TextBlock Text="{Binding CooldownBadge}" FontSize="12" Foreground="#E0B060" />
                                                                </Border>
                                                                <Border Classes="resBadge" Background="#333E9EFF" CornerRadius="3" Padding="5,0"
                                                                        ToolTip.Tip="{Binding ResourceTip}"
                                                                        IsVisible="{Binding ResourceBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                    <TextBlock Text="{Binding ResourceBadge}" FontSize="12" Foreground="#7FBFFF" />
                                                                </Border>
                                                                <TextBlock Text="⚙ 共享设置" FontSize="12" Opacity="0.7" VerticalAlignment="Center" IsVisible="{Binding HasOwnSettings}" />
                                                            </StackPanel>
                                                            <TextBlock Classes="desc" Text="{Binding Detail}" IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Classes="desc" Text="{Binding TypeText}" VerticalAlignment="Center" />
                                                        <CheckBox Grid.Column="2" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Panel>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="执行记录">
                                <DockPanel Margin="0,6,0,0">
                                    <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Content="刷新" Command="{Binding RefreshRunsCommand}" Margin="0,0,0,6" />
                                    <ScrollViewer>
                                        <ItemsControl ItemsSource="{Binding Runs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:TaskPlanRunRow">
                                                    <Border Classes="row">
                                                        <Grid ColumnDefinitions="90,*,60">
                                                            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding TimeText}" />
                                                                <TextBlock Classes="desc" Text="{Binding Message}" TextWrapping="Wrap" MaxHeight="40" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Classes="desc" Text="{Binding SourceText}" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="触发方式">
                                <views:TaskTriggerPanel />
                            </TabItem>
                            <TabItem Header="设置方案">
                                <!-- 设置方案与计划级共享设置（与新一条龙“共享设置”页共用） -->
                                <views:TaskPlanProfilesPanel />
                            </TabItem>
                            <TabItem Header="路线 CD">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,4,0,8">
                                        <Button Name="RefreshCooldownsButton" DockPanel.Dock="Left" Content="刷新" Command="{Binding RefreshCooldownsCommand}" Margin="0,0,10,0" />
                                        <CheckBox Name="CooldownPlanOnlyBox" DockPanel.Dock="Left" Content="仅本计划" IsChecked="{Binding CooldownsForPlanOnly}" Margin="0,0,10,0" />
                                        <TextBlock VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap"
                                                   Text="地图追踪路线的完成记录（与 Windows 版共用账本）；清除后下次运行不再按 CD 跳过该路线。" />
                                    </DockPanel>
                                    <Panel>
                                        <TextBlock Text="暂无路线 CD 记录。" Opacity="0.6" IsVisible="{Binding HasNoCooldowns}" Margin="4" />
                                        <ListBox Name="CooldownList" ItemsSource="{Binding Cooldowns}" IsVisible="{Binding !HasNoCooldowns}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:TaskPlanCooldownRow">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="清除" VerticalAlignment="Center"
                                                                Command="{Binding $parent[UserControl].((vm:TaskPlanPageViewModel)DataContext).ClearCooldownCommand}"
                                                                CommandParameter="{Binding}" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Route}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.65" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Panel>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </Panel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
