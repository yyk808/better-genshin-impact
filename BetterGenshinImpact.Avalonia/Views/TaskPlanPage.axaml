<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BetterGenshinImpact.Avalonia.ViewModels"
             xmlns:tasksVm="using:BetterGenshinImpact.ViewModel.SoloTaskSettings"
             xmlns:solo="using:BetterGenshinImpact.Avalonia.Views.SoloTaskSettings"
             x:Class="BetterGenshinImpact.Avalonia.Views.TaskPlanPage"
             x:DataType="vm:TaskPlanPageViewModel">
    <DockPanel Margin="20,16,20,12">
        <TextBlock DockPanel.Dock="Bottom" Classes="desc" Margin="4,8,0,0" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="230,*">
            <!-- 左侧：计划列表 -->
            <Border Grid.Column="0" Classes="card" Margin="0,0,10,0" Padding="10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="4,0,0,8">
                        <Button DockPanel.Dock="Right" Content="↻" Padding="8,2" Command="{Binding ReloadCommand}" ToolTip.Tip="重新加载" />
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="计划" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Classes="desc" Text="{Binding PlanCountText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="＋" Margin="6,0,0,0" Command="{Binding NewPlanCommand}" ToolTip.Tip="新建计划" />
                            <TextBox Watermark="新计划名称" Text="{Binding NewPlanName}" />
                        </DockPanel>
                        <Button Content="删除计划" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding DeletePlanCommand}" IsEnabled="{Binding HasSelectedPlan}" />
                        <TextBlock Classes="desc" Text="计划保存在 User/Pulonia，与 Windows 版共用" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TaskPlanItem">
                                <DockPanel Margin="2,4">
                                    <Button DockPanel.Dock="Right" Content="▶" Padding="8,2" VerticalAlignment="Center" ToolTip.Tip="运行"
                                            Command="{Binding $parent[ListBox].((vm:TaskPlanPageViewModel)DataContext).RunPlanCommand}"
                                            CommandParameter="{Binding}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Classes="desc" Text="{Binding Summary}" />
                                            <TextBlock Classes="desc" Text="· 运行中" Foreground="#4CC2FF" IsVisible="{Binding IsRunning}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 右侧：当前计划 -->
            <Border Grid.Column="1" Classes="card" Padding="14,10">
                <Panel>
                    <TextBlock Classes="desc" Text="还没有任务计划，在左侧输入名称后点“＋”新建。" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding !HasSelectedPlan}" />
                    <DockPanel IsVisible="{Binding HasSelectedPlan}">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Classes="accent" Content="运行" MinWidth="72" HorizontalContentAlignment="Center"
                                        Command="{Binding RunPlanCommand}" CommandParameter="{x:Null}" IsVisible="{Binding !IsSelectedPlanRunning}" />
                                <Button Classes="danger" Content="停止" MinWidth="72" HorizontalContentAlignment="Center"
                                        Command="{Binding StopPlanCommand}" IsVisible="{Binding IsSelectedPlanRunning}" />
                            </StackPanel>
                            <TextBlock Classes="pageTitle" FontSize="20" Text="{Binding SelectedPlan.Name, FallbackValue=''}" />
                        </DockPanel>
                        <TabControl SelectedIndex="{Binding SelectedTab}">
                            <TabItem Header="任务">
                                <DockPanel Margin="0,6,0,0">
                                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <ComboBox ItemsSource="{Binding AddOptions}" SelectedItem="{Binding SelectedAddOption}" MinWidth="170"
                                                  PlaceholderText="任务类型" Margin="0,0,6,4" />
                                        <ComboBox ItemsSource="{Binding Resources}" SelectedItem="{Binding SelectedResource}" MinWidth="220" MaxWidth="360"
                                                  IsVisible="{Binding HasResources}" Margin="0,0,6,4" />
                                        <Button Content="＋ 添加" Command="{Binding AddTaskCommand}" Margin="0,0,6,4" />
                                        <Button Content="分组" Command="{Binding AddGroupCommand}" Margin="0,0,6,4" />
                                        <ComboBox Name="ReferencePlanBox" ItemsSource="{Binding ReferencePlans}" SelectedItem="{Binding ReferenceTarget}"
                                                  PlaceholderText="引用计划" MinWidth="140" Margin="0,0,6,4" DisplayMemberBinding="{Binding Name}" />
                                        <Button Name="AddPlanReferenceButton" Content="引用" Command="{Binding AddPlanReferenceCommand}" Margin="0,0,14,4"
                                                ToolTip.Tip="引用已有任务计划：不复制内容，之后修改该计划会同步影响这里" />
                                        <Button Content="↑" Command="{Binding MoveTaskCommand}" CommandParameter="up" Margin="0,0,4,4" ToolTip.Tip="上移" />
                                        <Button Content="↓" Command="{Binding MoveTaskCommand}" CommandParameter="down" Margin="0,0,4,4" ToolTip.Tip="下移" />
                                        <Button Content="删除" Command="{Binding RemoveTaskCommand}" Margin="0,0,4,4" />
                                        <Button Name="NodeSettingsButton" Content="共享设置" Command="{Binding EditNodeSettingsCommand}" Margin="0,0,4,4"
                                                ToolTip.Tip="编辑选中分组或任务自身的共享设置（优先于计划级设置与方案）" />
                                    </WrapPanel>
                                    <TextBlock Name="PlanCooldownSummaryText" DockPanel.Dock="Top" Classes="desc" Margin="2,0,0,6" Text="{Binding PlanCooldownSummary}"
                                               ToolTip.Tip="{Binding PlanCooldownSummaryTip}"
                                               IsVisible="{Binding PlanCooldownSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <Border DockPanel.Dock="Top" Background="#14FFFFFF" CornerRadius="4" Padding="12,6">
                                        <Grid ColumnDefinitions="*,90,44">
                                            <TextBlock Classes="desc" Text="名称" />
                                            <TextBlock Grid.Column="1" Classes="desc" Text="类型" />
                                            <TextBlock Grid.Column="2" Classes="desc" Text="启用" />
                                        </Grid>
                                    </Border>
                                    <Border DockPanel.Dock="Right" Width="290" Margin="10,0,0,0" Padding="10,8" Background="#0FFFFFFF" CornerRadius="4"
                                            IsVisible="{Binding HasNodeEditor}">
                                        <ScrollViewer>
                                            <StackPanel Spacing="6" Margin="0,0,6,0">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" x:Name="ApplyNodeButton" Classes="accent" Content="应用" Command="{Binding ApplyNodeSettingsCommand}" />
                                                    <StackPanel>
                                                        <TextBlock Text="任务设置" FontWeight="SemiBold" FontSize="15" />
                                                        <TextBlock Classes="desc" Text="{Binding NodeEditor.TypeText, FallbackValue=''}" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBlock Text="名称" />
                                                <TextBox x:Name="NodeNameBox" Text="{Binding NodeEditor.Name, FallbackValue=''}" />
                                                <CheckBox x:Name="NodeEnabledBox" Content="启用" IsChecked="{Binding NodeEditor.IsEnabled, FallbackValue=False}" />
                                                <StackPanel IsVisible="{Binding NodeEditor.IsGroup, FallbackValue=False}" Spacing="4">
                                                    <TextBlock Text="执行次数（分组）" />
                                                    <TextBox x:Name="NodeRepeatBox" Text="{Binding NodeEditor.RepeatText, FallbackValue=''}" />
                                                </StackPanel>
                                                <TextBlock Classes="desc" Text="{Binding NodeEditor.FieldsHint, FallbackValue=''}" TextWrapping="Wrap"
                                                           IsVisible="{Binding NodeEditor.FieldsHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
                                                <!-- 专属参数编辑器（与 WPF 任务计划的参数编辑相同：有专属界面时优先显示） -->
                                                <ContentControl x:Name="NodeDedicatedEditor" Content="{Binding NodeEditor.Dedicated, FallbackValue={x:Null}}"
                                                                IsVisible="{Binding NodeEditor.HasDedicated, FallbackValue=False}">
                                                    <ContentControl.DataTemplates>
                                                        <DataTemplate DataType="tasksVm:AutoDomainSettingsViewModel">
                                                            <solo:AutoDomainSettingsEditor />
                                                        </DataTemplate>
                                                        <DataTemplate DataType="tasksVm:AutoLeyLineOutcropSettingsViewModel">
                                                            <solo:AutoLeyLineOutcropSettingsEditor />
                                                        </DataTemplate>
                                                        <DataTemplate DataType="tasksVm:ClaimDailyRewardsSettingsViewModel">
                                                            <solo:ClaimDailyRewardsSettingsEditor />
                                                        </DataTemplate>
                                                        <DataTemplate DataType="tasksVm:CraftCondensedResinSettingsViewModel">
                                                            <solo:CraftCondensedResinSettingsEditor />
                                                        </DataTemplate>
                                                        <DataTemplate DataType="tasksVm:SereniteaPotSettingsViewModel">
                                                            <solo:SereniteaPotSettingsEditor />
                                                        </DataTemplate>
                                                        <DataTemplate DataType="tasksVm:AutoBossSettingsViewModel">
                                                            <solo:AutoBossSettingsEditor />
                                                        </DataTemplate>
                                                        <DataTemplate DataType="tasksVm:AutoStygianOnslaughtSettingsViewModel">
                                                            <solo:AutoStygianOnslaughtSettingsEditor />
                                                        </DataTemplate>
                                                        <DataTemplate DataType="tasksVm:ResinPlanSettingsViewModel">
                                                            <solo:ResinPlanSettingsEditor />
                                                        </DataTemplate>
                                                    </ContentControl.DataTemplates>
                                                </ContentControl>
                                                <TextBlock Text="{Binding NodeEditor.FieldsTitle, FallbackValue=''}" FontWeight="SemiBold" Margin="0,4,0,0" IsVisible="{Binding NodeEditor.HasFields, FallbackValue=False}" />
                                                <ItemsControl ItemsSource="{Binding NodeEditor.Fields, FallbackValue={x:Null}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:TaskParameterFieldEditor">
                                                            <StackPanel Margin="0,4" Spacing="3" Tag="{Binding Name}">
                                                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                                                <TextBlock Classes="desc" Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" IsVisible="{Binding HasDescription}" />
                                                                <ToggleSwitch IsChecked="{Binding BoolValue}" IsVisible="{Binding IsBoolean}" OnContent="" OffContent="" />
                                                                <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" IsVisible="{Binding IsChoice}" HorizontalAlignment="Stretch" />
                                                                <TextBox Text="{Binding Text}" IsVisible="{Binding IsTextInput}" AcceptsReturn="{Binding IsMultiline}" TextWrapping="Wrap" MaxHeight="120" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                    <Panel>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" IsVisible="{Binding HasNoNodes}">
                                            <TextBlock Text="这个计划还没有任务" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <TextBlock Classes="desc" Text="在上方选择任务类型（独立任务、录制回放、地图追踪、JS 脚本、Shell）后点“添加”" />
                                        </StackPanel>
                                        <ListBox ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}" Background="Transparent">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:TaskPlanNodeRow">
                                                    <Grid ColumnDefinitions="*,90,44" Opacity="{Binding RowOpacity}">
                                                        <StackPanel Margin="{Binding Indent}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding Name}" />
                                                                <Border Classes="cdBadge" Background="#33E0A030" CornerRadius="3" Padding="5,0"
                                                                        ToolTip.Tip="{Binding CooldownTip}"
                                                                        IsVisible="{Binding CooldownBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                    <TextBlock Text="{Binding CooldownBadge}" FontSize="12" Foreground="#E0B060" />
                                                                </Border>
                                                                <TextBlock Text="⚙ 共享设置" FontSize="12" Opacity="0.7" VerticalAlignment="Center" IsVisible="{Binding HasOwnSettings}" />
                                                            </StackPanel>
                                                            <TextBlock Classes="desc" Text="{Binding Detail}" IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Classes="desc" Text="{Binding TypeText}" VerticalAlignment="Center" />
                                                        <CheckBox Grid.Column="2" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Panel>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="执行记录">
                                <DockPanel Margin="0,6,0,0">
                                    <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Content="刷新" Command="{Binding RefreshRunsCommand}" Margin="0,0,0,6" />
                                    <ScrollViewer>
                                        <ItemsControl ItemsSource="{Binding Runs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:TaskPlanRunRow">
                                                    <Border Classes="row">
                                                        <Grid ColumnDefinitions="90,*,60">
                                                            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding TimeText}" />
                                                                <TextBlock Classes="desc" Text="{Binding Message}" TextWrapping="Wrap" MaxHeight="40" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Classes="desc" Text="{Binding SourceText}" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="触发方式">
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock DockPanel.Dock="Bottom" Classes="desc" TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding SchedulerStatus, StringFormat='调度：{0}'}" />
                                    <TextBlock x:Name="PlanHotkeyStatus" DockPanel.Dock="Bottom" Classes="desc" TextWrapping="Wrap" Text="{Binding HotkeyStatus, StringFormat='计划快捷键：{0}'}" />
                                    <Border DockPanel.Dock="Right" Width="290" Margin="10,0,0,0" Padding="10,8" Background="#0FFFFFFF" CornerRadius="4"
                                            IsVisible="{Binding HasTriggerEditor}">
                                        <ScrollViewer>
                                        <StackPanel Spacing="6" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding TriggerEditor.Title, FallbackValue=''}" FontWeight="SemiBold" FontSize="15" />
                                            <StackPanel Spacing="6" IsVisible="{Binding TriggerEditor.IsSchedule, FallbackValue=False}">
                                                <TextBlock Text="Cron 表达式（分 时 日 月 周）" />
                                                <TextBox x:Name="TriggerCronBox" Text="{Binding TriggerEditor.Cron, FallbackValue=''}" />
                                                <TextBlock Text="服务器时区" />
                                                <ComboBox ItemsSource="{Binding TriggerEditor.ServerTimeZones, FallbackValue={x:Null}}" SelectedIndex="{Binding TriggerEditor.ServerTimeZoneIndex, FallbackValue=0}" HorizontalAlignment="Stretch" />
                                                <TextBlock Text="忙碌时" />
                                                <ComboBox ItemsSource="{Binding TriggerEditor.BusyPolicies, FallbackValue={x:Null}}" SelectedIndex="{Binding TriggerEditor.BusyPolicyIndex, FallbackValue=0}" HorizontalAlignment="Stretch" />
                                                <TextBlock Text="允许延迟启动（分钟）" />
                                                <TextBox Text="{Binding TriggerEditor.WindowMinutes, FallbackValue=''}" />
                                                <CheckBox Content="错过时补跑一次" IsChecked="{Binding TriggerEditor.CatchUp, FallbackValue=False}" />
                                            </StackPanel>
                                            <StackPanel Spacing="6" IsVisible="{Binding TriggerEditor.IsHotkey, FallbackValue=False}">
                                                <TextBlock Text="快捷键" />
                                                <DockPanel>
                                                    <Button x:Name="TriggerRecordButton" DockPanel.Dock="Right" Margin="6,0,0,0" Content="录制"
                                                            Command="{Binding TriggerEditor.ToggleRecordCommand, FallbackValue={x:Null}}" />
                                                    <TextBox x:Name="TriggerHotkeyBox" Text="{Binding TriggerEditor.Hotkey, FallbackValue=''}" />
                                                </DockPanel>
                                                <TextBlock Classes="desc" Text="请按下快捷键…（Esc 取消）" IsVisible="{Binding TriggerEditor.IsRecording, FallbackValue=False}" />
                                                <TextBlock Text="方式" />
                                                <ComboBox x:Name="TriggerHotkeyType" ItemsSource="{Binding TriggerEditor.HotkeyTypes, FallbackValue={x:Null}}"
                                                          SelectedIndex="{Binding TriggerEditor.HotkeyTypeIndex, FallbackValue=0}" HorizontalAlignment="Stretch" />
                                                <TextBlock Classes="desc" TextWrapping="Wrap" Text="全局热键支持组合键或功能键（F12 保留），注册期间游戏收不到该键；键鼠监听只接受单键，不拦截按键。" />
                                            </StackPanel>
                                            <CheckBox x:Name="TriggerEnabledBox" Content="启用" IsChecked="{Binding TriggerEditor.Enabled, FallbackValue=False}" />
                                            <TextBlock Classes="desc" Text="{Binding TriggerEditor.PreviewText, FallbackValue=''}" TextWrapping="Wrap" />
                                            <Button x:Name="SaveTriggerButton" Classes="accent" Content="保存触发器" HorizontalAlignment="Right"
                                                    Command="{Binding SaveTriggerCommand}" IsEnabled="{Binding TriggerEditor.IsValid, FallbackValue=False}" />
                                        </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                                        <Button x:Name="AddScheduleTriggerButton" Content="＋ 定时触发" Command="{Binding AddScheduleTriggerCommand}" />
                                        <Button x:Name="AddHotkeyTriggerButton" Content="＋ 快捷键触发" Command="{Binding AddHotkeyTriggerCommand}" />
                                        <Button Content="删除" Command="{Binding DeleteTriggerCommand}" CommandParameter="{x:Null}" />
                                    </StackPanel>
                                    <Panel>
                                        <TextBlock Classes="desc" TextWrapping="Wrap" IsVisible="{Binding HasNoTriggers}"
                                                   Text="没有触发方式：只能手动运行。点“＋ 定时触发”或“＋ 快捷键触发”添加，保存并启用后生效。" />
                                        <ListBox ItemsSource="{Binding Triggers}" SelectedItem="{Binding SelectedTrigger}" Background="Transparent">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:TaskPlanTriggerRow">
                                                    <DockPanel>
                                                        <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Enabled}" OnContent="" OffContent="" VerticalAlignment="Center" />
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding KindText}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Text}" />
                                                            </StackPanel>
                                                            <TextBlock Classes="desc" Text="{Binding Detail}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Panel>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="设置方案">
                                <ScrollViewer>
                                    <StackPanel Spacing="8" Margin="0,4,0,0">
                                        <TextBlock Text="本计划使用的方案" FontWeight="SemiBold" />
                                        <ComboBox Name="PlanProfileBox" ItemsSource="{Binding PlanProfileOptions}" SelectedItem="{Binding PlanProfile}" MinWidth="260"
                                                  DisplayMemberBinding="{Binding Name}" />
                                        <Button Name="EditPlanSettingsButton" Content="编辑计划级共享设置" Command="{Binding EditPlanSettingsCommand}" />
                                        <TextBlock Classes="desc" TextWrapping="Wrap"
                                                   Text="计划级共享设置：方案中的设置（队伍、战斗、拾取、路线 CD 等）传给计划中的全部任务，任务或分组自己的设置优先。方案与 Windows 版共用（User/Pulonia/profiles）。" />
                                        <Separator Margin="0,4" />
                                        <TextBlock Text="设置方案管理" FontWeight="SemiBold" />
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Spacing="6" Margin="10,0,0,0">
                                                <TextBox Name="ProfileNameBox" Text="{Binding ProfileName}" Watermark="方案名称" Width="200" />
                                                <Button Name="CreateProfileButton" Content="新建" Command="{Binding CreateProfileCommand}" HorizontalAlignment="Stretch" />
                                                <Button Name="DuplicateProfileButton" Content="复制" Command="{Binding DuplicateProfileCommand}" HorizontalAlignment="Stretch" />
                                                <Button Name="RenameProfileButton" Content="重命名" Command="{Binding RenameProfileCommand}" HorizontalAlignment="Stretch" />
                                                <Button Name="DeleteProfileButton" Content="删除" Command="{Binding DeleteProfileCommand}" HorizontalAlignment="Stretch" />
                                                <Button Name="EditProfileSettingsButton" Content="编辑方案设置" Command="{Binding EditProfileSettingsCommand}" HorizontalAlignment="Stretch" />
                                            </StackPanel>
                                            <StackPanel Spacing="6">
                                                <ListBox Name="ProfileList" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" MinHeight="160">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:TaskPlanProfileItem">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" />
                                                                <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.65" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <TextBlock Classes="desc" TextWrapping="Wrap" Text="{Binding ProfileUsageText}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <!-- 共享设置编辑（计划级或方案） -->
                                        <Border Name="SharedSettingsPanel" IsVisible="{Binding SharedEditor, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,6,0,0">
                                            <StackPanel Spacing="8" DataContext="{Binding SharedEditor}" x:DataType="vm:TaskPlanSharedSettingsEditor">
                                                <DockPanel>
                                                    <Button Name="SaveSharedSettingsButton" DockPanel.Dock="Right" Classes="accent" Content="保存" Command="{Binding SaveCommand}" />
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <ComboBox Name="SharedCategoryBox" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" MinWidth="200"
                                                          DisplayMemberBinding="{Binding DisplayName}" />
                                                <ItemsControl ItemsSource="{Binding Rows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:TaskPlanSharedSettingRow">
                                                            <Grid ColumnDefinitions="*,260" Margin="0,4">
                                                                <StackPanel>
                                                                    <CheckBox IsChecked="{Binding IsOverridden}" Content="{Binding Name}" ToolTip.Tip="勾选：在此处覆盖；不勾选：继承上层" />
                                                                    <TextBlock Classes="desc" Text="{Binding Description}" TextWrapping="Wrap" Margin="28,0,0,0"
                                                                               IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                                    <TextBlock Classes="desc" Text="{Binding InheritedText, StringFormat='继承值：{0}'}" Margin="28,0,0,0" />
                                                                    <TextBlock Classes="desc" Text="{Binding Cooldown.Preview, FallbackValue=''}" Margin="28,4,0,0" TextWrapping="Wrap"
                                                                               IsVisible="{Binding IsCooldown}" />
                                                                </StackPanel>
                                                                <Panel Grid.Column="1" VerticalAlignment="Center">
                                                                    <ToggleSwitch IsChecked="{Binding BoolValue}" IsVisible="{Binding IsBoolean}" OnContent="" OffContent="" HorizontalAlignment="Right" />
                                                                    <NumericUpDown Value="{Binding NumberValue}" IsVisible="{Binding IsNumber}" />
                                                                    <ComboBox ItemsSource="{Binding ChoiceLabels}" SelectedIndex="{Binding ChoiceIndex}" IsVisible="{Binding IsChoice}" HorizontalAlignment="Stretch" />
                                                                    <TextBox Text="{Binding TextValue}" IsVisible="{Binding IsText}" TextWrapping="Wrap" />
                                                                    <StackPanel Spacing="6" IsVisible="{Binding IsCooldown}">
                                                                        <ComboBox Name="CdChoiceBox" ItemsSource="{Binding CdChoiceLabels}" SelectedIndex="{Binding CdChoiceIndex}" HorizontalAlignment="Stretch" />
                                                                        <ComboBox Name="CdModeBox" ItemsSource="{Binding CdModeLabels}" SelectedIndex="{Binding CdModeIndex}" HorizontalAlignment="Stretch"
                                                                                  IsVisible="{Binding Cooldown.ShowCustom, FallbackValue=False}" />
                                                                        <DockPanel IsVisible="{Binding Cooldown.ShowHours, FallbackValue=False}">
                                                                            <TextBlock DockPanel.Dock="Right" Text="小时" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                                            <TextBox Name="CdHoursBox" Text="{Binding Cooldown.Hours, FallbackValue=''}" />
                                                                        </DockPanel>
                                                                        <DockPanel IsVisible="{Binding Cooldown.ShowDays, FallbackValue=False}">
                                                                            <TextBlock DockPanel.Dock="Right" Text="天" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                                            <TextBox Name="CdDaysBox" Text="{Binding Cooldown.Days, FallbackValue=''}" />
                                                                        </DockPanel>
                                                                        <ComboBox ItemsSource="{Binding CdWeekdayLabels}" SelectedIndex="{Binding CdWeekdayIndex}" HorizontalAlignment="Stretch"
                                                                                  IsVisible="{Binding Cooldown.ShowWeekday, FallbackValue=False}" />
                                                                        <ComboBox ItemsSource="{Binding CdHourLabels}" SelectedIndex="{Binding CdResetHourIndex}" HorizontalAlignment="Stretch"
                                                                                  IsVisible="{Binding Cooldown.ShowResetHour, FallbackValue=False}" ToolTip.Tip="服务器时间重置时刻" />
                                                                    </StackPanel>
                                                                </Panel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Name="SharedSettingsMessage" Classes="desc" Text="{Binding Message}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="路线 CD">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,4,0,8">
                                        <Button Name="RefreshCooldownsButton" DockPanel.Dock="Left" Content="刷新" Command="{Binding RefreshCooldownsCommand}" Margin="0,0,10,0" />
                                        <CheckBox Name="CooldownPlanOnlyBox" DockPanel.Dock="Left" Content="仅本计划" IsChecked="{Binding CooldownsForPlanOnly}" Margin="0,0,10,0" />
                                        <TextBlock VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap"
                                                   Text="地图追踪路线的完成记录（与 Windows 版共用账本）；清除后下次运行不再按 CD 跳过该路线。" />
                                    </DockPanel>
                                    <Panel>
                                        <TextBlock Text="暂无路线 CD 记录。" Opacity="0.6" IsVisible="{Binding HasNoCooldowns}" Margin="4" />
                                        <ListBox Name="CooldownList" ItemsSource="{Binding Cooldowns}" IsVisible="{Binding !HasNoCooldowns}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:TaskPlanCooldownRow">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="清除" VerticalAlignment="Center"
                                                                Command="{Binding $parent[UserControl].((vm:TaskPlanPageViewModel)DataContext).ClearCooldownCommand}"
                                                                CommandParameter="{Binding}" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Route}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.65" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Panel>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </Panel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
