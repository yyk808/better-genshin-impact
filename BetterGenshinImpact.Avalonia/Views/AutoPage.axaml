<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BetterGenshinImpact.Avalonia.ViewModels"
             xmlns:views="using:BetterGenshinImpact.Avalonia.Views"
             x:Class="BetterGenshinImpact.Avalonia.Views.AutoPage"
             x:DataType="vm:AutoPageViewModel">
    <TabControl SelectedIndex="{Binding SelectedTab}" Padding="0">
        <TabItem Header="调度器">
            <views:ScriptControlPage DataContext="{Binding Scheduler}" />
        </TabItem>
            <TabItem Header="JS 脚本">
                <DockPanel Margin="20,8,20,12">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshCommand}" />
                        <TextBlock Classes="desc" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="{Binding JsFolder, StringFormat='目录：{0}　“添加”加入调度器中选中的配置组'}" />
                    </DockPanel>
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding JsScripts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AutoScriptItem">
                                    <Border Classes="row">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Button Content="添加" Padding="10,2"
                                                        Command="{Binding $parent[ItemsControl].((vm:AutoPageViewModel)DataContext).AddJsCommand}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" />
                                                <TextBlock Classes="desc" Text="{Binding Detail}" />
                                                <TextBlock Classes="desc" Text="{Binding Description}" TextWrapping="Wrap" MaxHeight="40" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <TabItem Header="地图追踪">
                <DockPanel Margin="20,8,20,12">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshCommand}" />
                        <TextBlock Classes="desc" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="{Binding PathingFolder, StringFormat='目录：{0}　“添加”加入调度器中选中的配置组'}" />
                    </DockPanel>
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding PathingScripts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AutoScriptItem">
                                    <Border Classes="row">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Button Content="添加" Padding="10,2"
                                                        Command="{Binding $parent[ItemsControl].((vm:AutoPageViewModel)DataContext).AddPathingCommand}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" />
                                                <TextBlock Classes="desc" Text="{Binding Detail}" />
                                                <TextBlock Classes="desc" Text="{Binding Description}" TextWrapping="Wrap" MaxHeight="40" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <TabItem Header="录制回放">
                <DockPanel Margin="20,8,20,12">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                            <Button Content="开始录制" Command="{Binding StartRecordCommand}" IsEnabled="{Binding !IsRecording}" />
                            <Button Content="停止录制" Command="{Binding StopRecordCommand}" IsEnabled="{Binding IsRecording}" />
                            <Button Content="刷新" Command="{Binding RefreshCommand}" />
                        </StackPanel>
                        <TextBlock Classes="desc" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="{Binding KmFolder, StringFormat='目录：{0}　“添加”加入调度器中选中的配置组；录制需先启动截图器，3 秒后开始'}" />
                    </DockPanel>
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding KmScripts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AutoScriptItem">
                                    <Border Classes="row">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Button Content="回放 / 停止" Padding="10,2"
                                                        Command="{Binding $parent[ItemsControl].((vm:AutoPageViewModel)DataContext).PlayKmCommand}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="添加" Padding="10,2"
                                                        Command="{Binding $parent[ItemsControl].((vm:AutoPageViewModel)DataContext).AddKmCommand}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" />
                                                <TextBlock Classes="desc" Text="{Binding Detail}" />
                                                <TextBlock Classes="desc" Text="{Binding Description}" TextWrapping="Wrap" MaxHeight="40" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
    </TabControl>
</UserControl>
