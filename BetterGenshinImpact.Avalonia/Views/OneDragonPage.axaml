<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BetterGenshinImpact.Avalonia.ViewModels"
             xmlns:model="using:BetterGenshinImpact.Model"
             xmlns:cfg="using:BetterGenshinImpact.Core.Config"
             x:Class="BetterGenshinImpact.Avalonia.Views.OneDragonPage"
             x:DataType="vm:OneDragonPageViewModel">
    <ScrollViewer>
        <StackPanel Margin="28,20,28,20" Spacing="4">
            <DockPanel>
                <Button DockPanel.Dock="Right" MinWidth="96" HorizontalContentAlignment="Center" VerticalAlignment="Center"
                        Content="{Binding Tasks.IsTaskActive, Converter={x:Static vm:OneDragonPageConverters.RunButtonText}}"
                        Command="{Binding ToggleCommand}" />
                <StackPanel>
                    <TextBlock Classes="pageTitle" Text="一条龙" FontSize="20" />
                    <TextBlock Classes="desc" Text="{Binding Tasks.StatusText, StringFormat='状态：{0}'}" Margin="0,2,0,8" />
                </StackPanel>
            </DockPanel>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right" Width="240" ItemsSource="{Binding ConfigList}" SelectedItem="{Binding SelectedConfig}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="cfg:OneDragonFlowConfig">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <StackPanel>
                            <TextBlock Classes="title" Text="一条龙配置" />
                            <TextBlock Classes="desc" Text="User/OneDragon 下的配置文件（与 Windows 版共用）" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right" Width="240" ItemsSource="{Binding CompletionActionList}"
                                  SelectedItem="{Binding SelectedConfig.CompletionAction}" />
                        <StackPanel>
                            <TextBlock Classes="title" Text="完成后操作" />
                            <TextBlock Classes="desc" Text="任务完成后执行的操作" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="保存配置" Command="{Binding SaveConfigCommand}" />
                <StackPanel>
                    <TextBlock Classes="section" Text="任务列表" />
                    <TextBlock Classes="desc" Text="{Binding NextTaskText}" />
                </StackPanel>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding TaskList}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="model:OneDragonTaskItem">
                        <Border Classes="subcard">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="从此执行" Padding="10,3"
                                        Command="{Binding $parent[ItemsControl].((vm:OneDragonPageViewModel)DataContext).SetTaskAsNextCommand}"
                                        CommandParameter="{Binding}" />
                                <TextBlock DockPanel.Dock="Right" Text="▶ 下次从这里开始" Margin="0,0,12,0" VerticalAlignment="Center"
                                           Foreground="#4CC2FF" IsVisible="{Binding IsNextTask}" />
                                <CheckBox IsChecked="{Binding IsEnabled}" Margin="0,0,8,0" />
                                <Ellipse Width="10" Height="10" Fill="Gray" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="desc" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="各任务的详细设置（秘境、首领、地脉花、尘歌壶等）、新增/删除/排序任务与配置的界面尚未迁移，使用配置文件中的值。执行逻辑与 Windows 版相同（Core 的 OneDragonTask）。" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
