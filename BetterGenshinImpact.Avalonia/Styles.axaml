<Styles xmlns="https://github.com/avaloniaui"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 原版 BGI（WPF-UI，深色）的配色；卡片、文字颜色取 FluentAvalonia 主题资源（与 WinUI / WPF-UI 同名同值） -->
    <Styles.Resources>
        <SolidColorBrush x:Key="BgiWindowBrush" Color="#1F1F1F" />
        <SolidColorBrush x:Key="BgiPaneBrush" Color="#1A1A1A" />
        <SolidColorBrush x:Key="BgiCardBrush" Color="#2B2B2B" />
        <SolidColorBrush x:Key="BgiCardBorderBrush" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="BgiSubTextBrush" Color="#A0A0A0" />
        <SolidColorBrush x:Key="BgiAccentBrush" Color="#4CC2FF" /><!-- 与 FluentAvalonia 深色主题的 AccentTextFillColorPrimary 一致 -->
        <SolidColorBrush x:Key="BgiLogBrush" Color="#181818" />
    </Styles.Resources>

    <!-- 卡片：图标 / 标题 / 说明 / 右侧控件，对应 WPF-UI 的 CardControl -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <!-- 列表行（任务计划的项目列表等） -->
    <Style Selector="Border.row">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,0,3" />
    </Style>
    <Style Selector="TabControl > TabItem, TabItem">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,4" />
    </Style>
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.subcard">
        <Setter Property="Background" Value="#262626" />
        <Setter Property="BorderBrush" Value="{StaticResource BgiCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1,0,1,1" />
        <Setter Property="CornerRadius" Value="0,0,6,6" />
        <Setter Property="Padding" Value="56,10,16,10" />
        <Setter Property="Margin" Value="0,-5,0,4" />
    </Style>
    <!-- 可展开的卡片（WPF-UI 的 CardExpander）：标题行与卡片相同，展开后显示子选项 -->
    <Style Selector="Expander.card">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Padding" Value="56,10,16,12" />
        <Setter Property="Background" Value="#262626" />
        <Setter Property="BorderBrush" Value="{StaticResource BgiCardBorderBrush}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Expander.card /template/ ToggleButton#ExpanderHeader">
        <Setter Property="Background" Value="{StaticResource BgiCardBrush}" />
        <Setter Property="MinHeight" Value="66" />
        <Setter Property="Padding" Value="16,8,12,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!-- 与可展开卡片的开关对齐（右侧留出展开箭头的位置） -->
    <Style Selector="Border.card ToggleSwitch">
        <Setter Property="Margin" Value="0,0,54,0" />
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBlock.desc">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.pageTitle">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,16,0,8" />
    </Style>
    <Style Selector="PathIcon.cardIcon">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="0,0,18,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- SettingsExpander 之间留出间距（WPF 版 CardExpander 之间有间隔） -->
    <!-- 卡片间距与 WPF 版 CardControl / CardExpander 的 Margin 0,0,0,12 相同 -->
    <Style Selector="ui|FASettingsExpander">
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- 与 WPF 设置页相同的页面布局：PagePadding 48,20,48,28，页标题 18 SemiBold，分组标题 BodyStrong，卡片间距 12 -->
    <Style Selector="StackPanel.page">
        <Setter Property="Margin" Value="48,20,48,28" />
    </Style>
    <Style Selector="StackPanel.page > ui|FASettingsExpander">
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="TextBlock.pagetitle">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="TextBlock.pagesection">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <!-- 选项卡由导航栏切换时隐藏标题栏（TabItem 仍保留，供界面自测按标题选择） -->
    <Style Selector="TabControl.nostrip /template/ ItemsPresenter#PART_ItemsPresenter">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- 旧的 ListBox 导航样式（主窗口已改用 FANavigationView，保留给其余列表） -->
    <Style Selector="ListBox.nav">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="6,1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinHeight" Value="38" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2DFFFFFF" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#1AFFFFFF" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem Border.indicator">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected Border.indicator">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="ListBox.log ListBoxItem">
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
</Styles>
