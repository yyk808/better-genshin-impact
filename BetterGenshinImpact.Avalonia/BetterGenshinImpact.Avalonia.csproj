<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Avalonia 宿主（纯 net10.0，Avalonia 12 + FluentAvaloniaUI 主题）：Linux 上的图形界面。
		启动引导与无界面宿主共用 BetterGenshinImpact.Host.Common 的 GameHost；
		UiHost（UI 线程、消息框、剪贴板）由本项目提供 Avalonia 实现。
		OpenCvSharpExtern / onnxruntime 原生库由 Host.Common 引用（本地构建见 Build/Linux/build-opencvsharp.sh）。
		素材与模型从 Windows 主程序的输出目录读取（&#45;&#45;assets 参数，见 README.md）。
	-->
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>BetterGenshinImpact.Avalonia</RootNamespace>
		<AssemblyName>bgi-avalonia</AssemblyName>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>14.0</LangVersion>
		<Platforms>x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<!-- 云原神输入 SDK：与 Windows 主程序共用同一个脚本文件 -->
		<EmbeddedResource Include="..\BetterGenshinImpact\Resources\JavaScript\ys-input-inject.js" LogicalName="BetterGenshinImpact.Resources.JavaScript.ys-input-inject.js" Link="Resources\ys-input-inject.js" />
	</ItemGroup>
	<ItemGroup>
		<!-- 导航与卡片图标字体：Fluent UI System Icons（MIT，https://github.com/microsoft/fluentui-system-icons），取自 WPF-UI 4.3.0 内嵌的同一字体 -->
		<AvaloniaResource Include="Assets\Fonts\FluentSystemIcons-Regular.ttf" />
		<!-- WPF 版图标字体（与 WPF 共用同一文件） -->
		<AvaloniaResource Include="..\BetterGenshinImpact\Resources\Fonts\Fgi-Regular.ttf" Link="Assets\Fonts\Fgi-Regular.ttf" />
		<!-- 首页横幅默认图：直接使用 WPF 的资源 -->
		<AvaloniaResource Include="..\BetterGenshinImpact\Resources\Images\banner.jpg" Link="Assets\Images\banner.jpg" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\BetterGenshinImpact.Host.Common\BetterGenshinImpact.Host.Common.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.4" />
		<!-- 网页视图（JS HTML 设置页）：Linux 上使用系统 WebKitGTK 4.1，不随包分发浏览器 -->
		<PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
		<!-- Fluent Design 组件（NavigationView、SettingsExpander、InfoBar、ContentDialog 等），对应 WPF 版的 WPF-UI -->
		<PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
	</ItemGroup>

</Project>
