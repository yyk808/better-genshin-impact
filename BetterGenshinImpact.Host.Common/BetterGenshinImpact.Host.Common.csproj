<Project Sdk="Microsoft.NET.Sdk">

	<!--
		宿主共用的启动引导（纯 net10.0）：平台服务（Linux X11）、配置、依赖注入、CoreServices / PlatformHost / GameSystem 初始化、
		CPU 推理、截图器与实时触发器的启动停止。无界面宿主（BetterGenshinImpact.Host.Headless）与
		Avalonia 宿主（BetterGenshinImpact.Avalonia）都经 GameHost 启动，Windows 的 WPF 主程序不使用。
		Linux 原生库（OpenCvSharpExtern、onnxruntime）也在这里引用，随项目引用复制到宿主的输出目录。
	-->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>BetterGenshinImpact.Host.Common</RootNamespace>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>14.0</LangVersion>
		<Platforms>x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

	<!--
		OpenCvSharp 的 Linux 原生库（libOpenCvSharpExtern.so）：
		- 首选自行编译的完整构建：运行 Build/Linux/build-opencvsharp.sh 生成（OpenCV 4.11 + contrib，与托管包 OpenCvSharp4 4.11 对齐，
		  第三方库与 libstdc++ 静态链接，只依赖 glibc 2.27+）。默认取仓库根目录下 opencv-build/out/libOpenCvSharpExtern.so，
		  可用构建属性或同名环境变量 OpenCvSharpExternPath 指定其它路径。
		- 找不到时退回 Sdcb.OpenCvSharp4.mini.runtime.linux-x64（含 dnn，但不含 features2d / calib3d / xfeatures2d 等，
		  大地图特征匹配等功能不可用）。
		官方 OpenCvSharp4.official.runtime.linux-x64 依赖 Ubuntu 22.04 的 tesseract / ffmpeg / gtk2 等系统库，不使用。
	-->
	<PropertyGroup>
		<OpenCvSharpExternPath Condition="'$(OpenCvSharpExternPath)' == ''">$(MSBuildThisFileDirectory)..\opencv-build\out\libOpenCvSharpExtern.so</OpenCvSharpExternPath>
		<UseLocalOpenCvSharpExtern Condition="Exists('$(OpenCvSharpExternPath)')">true</UseLocalOpenCvSharpExtern>
	</PropertyGroup>

	<ItemGroup Condition="'$(UseLocalOpenCvSharpExtern)' == 'true'">
		<None Include="$(OpenCvSharpExternPath)" Link="runtimes\linux-x64\native\libOpenCvSharpExtern.so"
			CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
	</ItemGroup>

	<ItemGroup Condition="'$(UseLocalOpenCvSharpExtern)' != 'true'">
		<PackageReference Include="Sdcb.OpenCvSharp4.mini.runtime.linux-x64" Version="4.13.0.45" />
	</ItemGroup>

	<Target Name="ReportOpenCvSharpExtern" BeforeTargets="Build">
		<Message Importance="high" Condition="'$(UseLocalOpenCvSharpExtern)' == 'true'" Text="OpenCvSharpExtern：使用本地构建 $(OpenCvSharpExternPath)" />
		<Message Importance="high" Condition="'$(UseLocalOpenCvSharpExtern)' != 'true'" Text="OpenCvSharpExtern：未找到 $(OpenCvSharpExternPath)，使用 Sdcb 精简构建（无 features2d 等模块），完整构建见 Build/Linux/build-opencvsharp.sh" />
	</Target>

	<!-- 多实例（实例 IPC、Pulonia 远程派发）：与平台无关的部分直接编译 WPF 项目的源文件，平台部分在 Instance/*.Linux.cs -->
	<ItemGroup>
		<Compile Include="..\BetterGenshinImpact\Service\Instance\InstanceService.cs" Link="Instance\Shared\InstanceService.cs" />
		<Compile Include="..\BetterGenshinImpact\Service\Instance\InstanceBootstrap.cs" Link="Instance\Shared\InstanceBootstrap.cs" />
		<Compile Include="..\BetterGenshinImpact\Service\Instance\InstanceConnection.cs" Link="Instance\Shared\InstanceConnection.cs" />
		<Compile Include="..\BetterGenshinImpact\Service\Instance\MessageHandlers\InstanceRequestHandler.cs" Link="Instance\Shared\InstanceRequestHandler.cs" />
		<Compile Include="..\BetterGenshinImpact\Service\Instance\MessageHandlers\InstanceMessageState.cs" Link="Instance\Shared\InstanceMessageState.cs" />
		<Compile Include="..\BetterGenshinImpact\Service\Instance\MessageHandlers\PuloniaRunMessageHandler.cs" Link="Instance\Shared\PuloniaRunMessageHandler.cs" />
	</ItemGroup>

	<!-- 按键宏：解析器、执行器、Runner、文件格式、目录存储、模板直接编译 WPF 项目的源文件；平台部分（日志、计时、快捷键模型、回收站、热键宿主）在 KeyMacro/*.Linux.cs -->
	<ItemGroup>
		<Compile Include="..\BetterGenshinImpact\GameTask\KeyMacro\Script\*.cs" Link="KeyMacro\Shared\Script\%(Filename)%(Extension)" />
		<Compile Include="..\BetterGenshinImpact\GameTask\KeyMacro\KeyMacroDefinition.cs" Link="KeyMacro\Shared\KeyMacroDefinition.cs" />
		<Compile Include="..\BetterGenshinImpact\GameTask\KeyMacro\KeyMacroFileFormat.cs" Link="KeyMacro\Shared\KeyMacroFileFormat.cs" />
		<Compile Include="..\BetterGenshinImpact\GameTask\KeyMacro\KeyMacroExecutor.cs" Link="KeyMacro\Shared\KeyMacroExecutor.cs" />
		<Compile Include="..\BetterGenshinImpact\GameTask\KeyMacro\KeyMacroRunner.cs" Link="KeyMacro\Shared\KeyMacroRunner.cs" />
		<Compile Include="..\BetterGenshinImpact\GameTask\KeyMacro\PreciseDelay.cs" Link="KeyMacro\Shared\PreciseDelay.cs" />
		<Compile Include="..\BetterGenshinImpact\Service\KeyMacro\KeyMacroStore.cs" Link="KeyMacro\Shared\KeyMacroStore.cs" />
		<Compile Include="..\BetterGenshinImpact\ViewModel\Pages\KeyMacro\KeyMacroTemplates.cs" Link="KeyMacro\Shared\KeyMacroTemplates.cs" />
	</ItemGroup>

	<!-- 地图点位：点位服务与米游社 / HoYoLab / 空荧酒馆接口、文件缓存直接编译 WPF 项目的源文件（不依赖 WPF） -->
	<ItemGroup>
		<PackageReference Include="LazyCache" Version="2.4.0" />
		<Compile Include="..\BetterGenshinImpact\Service\MaskMapPointService.cs" Link="MapPoints\Shared\MaskMapPointService.cs" />
		<Compile Include="..\BetterGenshinImpact\Service\MihoyoMapApiService.cs" Link="MapPoints\Shared\MihoyoMapApiService.cs" />
		<Compile Include="..\BetterGenshinImpact\Service\HoYoLabMapApiService.cs" Link="MapPoints\Shared\HoYoLabMapApiService.cs" />
		<Compile Include="..\BetterGenshinImpact\Service\Tavern\KongyingTavernApiService.cs" Link="MapPoints\Shared\KongyingTavernApiService.cs" />
		<Compile Include="..\BetterGenshinImpact\Infrastructure\Cache\FileCache.cs" Link="MapPoints\Shared\FileCache.cs" />
		<Compile Include="..\BetterGenshinImpact\Infrastructure\Cache\CacheMaintenanceService.cs" Link="MapPoints\Shared\CacheMaintenanceService.cs" />
		<Compile Include="..\BetterGenshinImpact\ViewModel\MaskWindowViewModel.MapPoints.cs" Link="MapPoints\Shared\MaskWindowViewModel.MapPoints.cs" />
		<Compile Include="..\BetterGenshinImpact\ViewModel\MaskMapPointInfoPopupViewModel.cs" Link="MapPoints\Shared\MaskMapPointInfoPopupViewModel.cs" />
	</ItemGroup>

	<!-- 脚本仓库：Git 同步、订阅更新、仓库网页桥接直接编译 WPF 项目的源文件；平台部分（网页窗口、确认框、Git 凭据）在 ScriptRepo/*.Linux.cs -->
	<ItemGroup>
		<Compile Include="..\BetterGenshinImpact\Core\Script\ScriptRepoUpdater.cs" Link="ScriptRepo\Shared\ScriptRepoUpdater.cs" />
		<Compile Include="..\BetterGenshinImpact\Core\Script\ScriptRepoUpdater.Repositories.cs" Link="ScriptRepo\Shared\ScriptRepoUpdater.Repositories.cs" />
		<Compile Include="..\BetterGenshinImpact\Core\Script\WebView\RepoWebBridge.cs" Link="ScriptRepo\Shared\RepoWebBridge.cs" />
		<Compile Include="..\BetterGenshinImpact\ViewModel\Message\RefreshDataMessage.cs" Link="ScriptRepo\Shared\RefreshDataMessage.cs" />
		<Compile Include="..\BetterGenshinImpact\Helpers\Http\ProxySpeedTester.cs" Link="ScriptRepo\Shared\ProxySpeedTester.cs" />
		<Compile Include="..\BetterGenshinImpact\Infrastructure\Network\GitProxy.cs" Link="ScriptRepo\Shared\GitProxy.cs" />
		<Compile Include="..\BetterGenshinImpact\Infrastructure\Temp\TempFileService.cs" Link="ScriptRepo\Shared\TempFileService.cs" />
		<Compile Include="..\BetterGenshinImpact\Pulonia\Services\PuloniaRepositoryManagementService.cs" Link="ScriptRepo\Shared\PuloniaRepositoryManagementService.cs" />
	</ItemGroup>

	<!-- 悬浮小窗 / 字幕浮窗：服务、游戏窗口跟随、视图模型直接编译 WPF 项目的源文件；平台部分（计时器、显示器、前台窗口、提示）在 Guide/*.Linux.cs -->
	<ItemGroup>
		<Compile Include="..\BetterGenshinImpact\Service\Guide\GuideWindowService.cs" Link="Guide\Shared\GuideWindowService.cs" />
		<Compile Include="..\BetterGenshinImpact\Service\Guide\IGuideWindowView.cs" Link="Guide\Shared\IGuideWindowView.cs" />
		<Compile Include="..\BetterGenshinImpact\ViewModel\IViewModel.cs" Link="Guide\Shared\IViewModel.cs" />
		<Compile Include="..\BetterGenshinImpact\ViewModel\Windows\GuideWindowViewModel.cs" Link="Guide\Shared\GuideWindowViewModel.cs" />
		<Compile Include="..\BetterGenshinImpact\ViewModel\Windows\GuideSubtitleWindowViewModel.cs" Link="Guide\Shared\GuideSubtitleWindowViewModel.cs" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\BetterGenshinImpact.Core\BetterGenshinImpact.Core.csproj" />
		<ProjectReference Include="..\BetterGenshinImpact.Platform.Linux\BetterGenshinImpact.Platform.Linux.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- 外部访问（HTTP API / WebSocket 日志 / MCP）：WPF 项目里与平台无关的源文件直接编译，与 WPF 相同的 Kestrel 子 WebApplication -->
		<!-- 外部访问服务（Kestrel / MCP）；Microsoft.Extensions.* 由该共享框架提供，不再单独引用包 -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
		<Compile Include="..\BetterGenshinImpact\Service\ExternalAccess\ExternalAccessHost.cs" Link="ExternalAccess\Shared\ExternalAccessHost.cs" />
		<Compile Include="..\BetterGenshinImpact\Service\ExternalAccess\ExternalLogWebSocketHandler.cs" Link="ExternalAccess\Shared\ExternalLogWebSocketHandler.cs" />
		<Compile Include="..\BetterGenshinImpact\Service\ExternalAccess\BgiExternalCapabilityService.cs" Link="ExternalAccess\Shared\BgiExternalCapabilityService.cs" />
		<Compile Include="..\BetterGenshinImpact\Service\ExternalAccess\Mcp\BgiMcpTools.cs" Link="ExternalAccess\Shared\BgiMcpTools.cs" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="9.0.1" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
		<!-- ONNX Runtime 原生库（linux-x64 为 libonnxruntime.so，CPU 推理），版本与 Core 的 Microsoft.ML.OnnxRuntime.Managed 一致 -->
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.21.0" />
	</ItemGroup>

</Project>
