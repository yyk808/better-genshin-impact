<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Core 的单元测试：纯 net10.0，Windows / Linux 上都可直接 dotnet test，
        不依赖 WPF / Win32 / 显示环境。迁入 Core 的逻辑在这里补测试。
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14.0</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Platforms>x64</Platforms>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0"/>
        <PackageReference Include="xunit" Version="2.5.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3"/>
        <!-- 识别代码迁入 Core 后，其测试需要 OpenCV 原生库：Windows 用官方运行时，Linux 用不依赖 GTK / FFmpeg 的精简版 -->
        <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.11.0.20250507"/>
        <PackageReference Include="Sdcb.OpenCvSharp4.mini.runtime.ubuntu.22.04-x64" Version="4.11.0.35"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
        <Using Include="BetterGenshinImpact.Platform"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="TestData\**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <!-- 与主单测项目共用的测试替身（源码链接，不复制） -->
        <Compile Include="..\BetterGenshinImpact.UnitTest\FakeLogger.cs" Link="Shared\FakeLogger.cs" />
        <Compile Include="..\BetterGenshinImpact.UnitTest\GameTaskTests\AutoFishingTests\FakeInputChannel.cs" Link="Shared\FakeInputChannel.cs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\BetterGenshinImpact.Core\BetterGenshinImpact.Core.csproj"/>
        <ProjectReference Include="..\..\BetterGenshinImpact.Platform.Linux\BetterGenshinImpact.Platform.Linux.csproj"/>
        <ProjectReference Include="..\..\BetterGenshinImpact.Host.Common\BetterGenshinImpact.Host.Common.csproj"/>
    </ItemGroup>

</Project>
