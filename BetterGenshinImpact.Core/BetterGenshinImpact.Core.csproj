<Project Sdk="Microsoft.NET.Sdk">

	<!--
		平台无关的核心类库（纯 net10.0，不带 -windows）。
		第一阶段：平台抽象层（键码、几何类型、窗口/截图/输入/热键接口）与输入通道基类。
		约束：这里不能引用任何 Windows 专属的包或 API（Vanara、WPF、WinForms、System.Drawing.Common 等），
		Linux 上不加 EnableWindowsTargeting 也必须能编译。
	-->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>BetterGenshinImpact</RootNamespace>
		<AssemblyName>BetterGenshinImpact.Core</AssemblyName>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<LangVersion>14.0</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Platforms>x64</Platforms>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<!-- 只引用托管包；OpenCvSharp4 的 native 运行时由宿主（Windows/Linux）按 RID 自行引用 -->
		<PackageReference Include="OpenCvSharp4" Version="4.11.0.20250507" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
		<!-- 识别 / 配置代码迁入后需要的跨平台托管包，版本与主项目一致 -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="Clipper2" Version="2.0.0" />
		<PackageReference Include="YamlDotNet" Version="16.3.0" />
		<PackageReference Include="NCalc" Version="6.2.0" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.21.0" />
		<!-- ImageRegion 的图像缓存（主项目经 YoloSharp 间接引用的同一版本） -->
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.7" />
		<!-- 邮件通知（EmailNotifier，纯托管，Windows 主程序与 Linux 宿主共用），版本与主项目一致 -->
		<PackageReference Include="MailKit" Version="4.16.0" />
		<!-- YOLO 推理（跨平台；依赖的 Microsoft.ML.OnnxRuntime 含 Windows / Linux 原生库），版本与主项目一致 -->
		<PackageReference Include="YoloSharp" Version="6.0.3" />
		<!-- 简繁转换（纯托管），I18nService 使用，版本与主项目一致 -->
		<PackageReference Include="OpenccNetLib" Version="1.7.0" />
		<!-- 版本号比较（Global）与 Serilog 静态日志（部分识别 / 配置代码直接使用），版本与主项目解析结果一致 -->
		<PackageReference Include="Semver" Version="3.0.0" />
		<PackageReference Include="Serilog" Version="4.2.0" />
		<!-- 任务的翻译资源（IStringLocalizer<T> 按 T 所在程序集查找 .resx，任务类与其 .resx 一起移入 Core） -->
		<PackageReference Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.12" />
		<PackageReference Include="CsTrees" Version="1.0.5" />
		<PackageReference Include="CsTrees.MEAI" Version="1.0.2" />
		<PackageReference Include="Microsoft.Extensions.AI" Version="10.6.0" />
		<PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.6.0" />
		<PackageReference Include="Anthropic" Version="12.53.0" />
		<PackageReference Include="LibGit2Sharp" Version="0.31.0" />
		<PackageReference Include="Microsoft.ClearScript.V8" Version="7.4.5" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
		<PackageReference Include="SkiaSharp" Version="3.119.4" />
		<PackageReference Include="NAudio.Core" Version="2.2.1" />
		<PackageReference Include="NLayer.NAudioSupport" Version="2.0.1" />
		<PackageReference Include="Melanchall.DryWetMidi" Version="8.0.3" />
		<PackageReference Include="HungarianAlgorithm" Version="2.3.5" />
		<PackageReference Include="System.IO.Packaging" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<!-- 奖励停止数据：TargetItemCatalog 按 typeof(TargetItemCatalog).Assembly 读取，随类一起移入 Core，资源名不变 -->
		<None Remove="Resources\TargetItem\target-item-data.json" />
		<EmbeddedResource Include="Resources\TargetItem\target-item-data.json" LogicalName="BetterGenshinImpact.Resources.TargetItem.target-item-data.json" />
		<EmbeddedResource Include="Resources\QuestVoice\auto-scene.json" LogicalName="BetterGenshinImpact.Resources.QuestVoice.auto-scene.json" />
		<EmbeddedResource Include="Resources\QuestVoice\routing.example.json" LogicalName="BetterGenshinImpact.Resources.QuestVoice.routing.example.json" />
	</ItemGroup>

	<ItemGroup>
		<!-- 从主项目搬入的代码保留原有的 internal 可见性：主项目与原单测项目仍可访问 -->
		<InternalsVisibleTo Include="BetterGI" />
		<InternalsVisibleTo Include="BetterGenshinImpact.UnitTest" />
		<InternalsVisibleTo Include="BetterGenshinImpact.Core.UnitTest" />
		<InternalsVisibleTo Include="BetterGenshinImpact.Host.Common" />
	</ItemGroup>

</Project>
