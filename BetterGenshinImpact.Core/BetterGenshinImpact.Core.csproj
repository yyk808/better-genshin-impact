<Project Sdk="Microsoft.NET.Sdk">

	<!--
		平台无关的核心类库（纯 net10.0，不带 -windows）。
		第一阶段：平台抽象层（键码、几何类型、窗口/截图/输入/热键接口）与输入通道基类。
		约束：这里不能引用任何 Windows 专属的包或 API（Vanara、WPF、WinForms、System.Drawing.Common 等），
		Linux 上不加 EnableWindowsTargeting 也必须能编译。
	-->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>BetterGenshinImpact</RootNamespace>
		<AssemblyName>BetterGenshinImpact.Core</AssemblyName>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<LangVersion>14.0</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Platforms>x64</Platforms>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<!-- 只引用托管包；OpenCvSharp4 的 native 运行时由宿主（Windows/Linux）按 RID 自行引用 -->
		<PackageReference Include="OpenCvSharp4" Version="4.11.0.20250507" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
		<!-- 识别 / 配置代码迁入后需要的跨平台托管包，版本与主项目一致 -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="Clipper2" Version="2.0.0" />
		<PackageReference Include="YamlDotNet" Version="16.3.0" />
		<PackageReference Include="NCalc" Version="6.2.0" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.21.0" />
		<!-- ImageRegion 的图像缓存（主项目经 YoloSharp 间接引用的同一版本） -->
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.7" />
	</ItemGroup>

	<ItemGroup>
		<!-- 从主项目搬入的代码保留原有的 internal 可见性：主项目与原单测项目仍可访问 -->
		<InternalsVisibleTo Include="BetterGI" />
		<InternalsVisibleTo Include="BetterGenshinImpact.UnitTest" />
		<InternalsVisibleTo Include="BetterGenshinImpact.Core.UnitTest" />
	</ItemGroup>

</Project>
